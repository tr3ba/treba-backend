@page "/sellers/new"
@rendermode InteractiveServer
@using Contracts.Telegram
@inject TelegramApiClient Api
@inject CatalogApiClient Catalog
@inject NavigationManager Navigation

<PageTitle>@L["WorkspaceCreateSeller"] — Treba Admin</PageTitle>
<a class="users-back-link" href="/sellers"><i class="bi bi-arrow-left"></i>@L["Sellers"]</a>
<section class="page-hero"><div><p class="eyebrow">@L["PartnerNetwork"]</p><h1>@L["WorkspaceCreateSeller"]</h1><p>@L["WorkspaceSellerWizardHint"]</p></div></section>
<section class="card-box dossier-section">
    @if(error is not null){<p class="feedback-error" role="alert">@error</p>}
    <EditForm Model="model" OnValidSubmit="Create" FormName="seller-workspace"><DataAnnotationsValidator/><ValidationSummary/>
        <div class="profile-form-grid">
            <label class="field-group"><span>@L["FirstName"] *</span><InputText class="form-control" @bind-Value="model.FirstName"/></label>
            <label class="field-group"><span>@L["LastName"] *</span><InputText class="form-control" @bind-Value="model.LastName"/></label>
            <label class="field-group"><span>Email *</span><InputText class="form-control" type="email" @bind-Value="model.Email" autocomplete="off"/></label>
            <label class="field-group"><span>@L["Password"] *</span><InputText class="form-control" type="password" @bind-Value="model.Password" autocomplete="new-password"/><small>@L["WorkspacePasswordHint"]</small></label>
            <label class="field-group"><span>@L["WorkspaceCompanyName"] *</span><InputText class="form-control" @bind-Value="model.CompanyName"/></label>
            <label class="field-group"><span>@L["TaxId"]</span><InputText class="form-control" disabled="@model.TestSeller" @bind-Value="model.TaxNumber"/></label>
            <label class="field-group"><span>@L["Phone"]</span><InputText class="form-control" @bind-Value="model.Phone"/></label>
            <label class="field-group"><span>@L["WorkspaceStoreName"] *</span><InputText class="form-control" @bind-Value="model.StoreName"/></label>
            <label class="field-group"><span>@L["WorkspaceStoreSlug"] *</span><InputText class="form-control" @bind-Value="model.StoreSlug" placeholder="rozetta-store"/></label>
            <label class="field-group"><span>@L["Description"]</span><InputTextArea class="form-control" @bind-Value="model.Description"/></label>
        </div>
        <div class="workspace-checks">
            <label><InputCheckbox @bind-Value="model.TestSeller"/> @L["WorkspaceTestSeller"]</label>
            <label><InputCheckbox @bind-Value="model.Active"/> @L["WorkspaceActivateSeller"]</label>
            <label><InputCheckbox @bind-Value="model.AllCategories"/> @L["WorkspaceAllCategories"]</label>
        </div>
        @if(!model.AllCategories)
        {
            <label class="field-group"><span>@L["SellerAllowedCategories"]</span><select class="form-control" multiple size="10" @onchange="CategoriesChanged">
                @foreach(var category in categories){<option value="@category.Id">@category.Name</option>}
            </select><small>@L["IncludeSubcategories"]</small></label>
        }
        <button class="primary-button" type="submit" disabled="@(busy||!loaded)">@L[busy?"Creating":"WorkspaceCreateSeller"]</button>
    </EditForm>
</section>
@code {
    private CreateSellerWorkspaceRequest model=new(){AllCategories=true};
    private IReadOnlyList<Contracts.Catalog.CatalogLookupDto> categories=[];
    private string? error;private bool busy,loaded;
    protected override async Task OnInitializedAsync(){try{categories=(await Catalog.FilterOptions()).Categories;loaded=true;}catch(HttpRequestException ex){error=ex.Message;}}
    private void CategoriesChanged(ChangeEventArgs args)=>model.CategoryIds=(args.Value as string[]??[]).Select(Guid.Parse).Distinct().ToList();
    private async Task Create()
    {
        busy=true;error=null;
        try{var result=await Api.Post<SellerWorkspaceCreatedDto>("api/v1/admin/sellers",model);model.Password="";Navigation.NavigateTo("/sellers/review/"+result.SellerId);}
        catch(HttpRequestException ex){error=ex.Message;}finally{busy=false;}
    }
}
