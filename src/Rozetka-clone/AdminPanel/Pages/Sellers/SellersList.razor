@page "/sellers"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text.Json
@inject ISellersApiClient SellersApi

<PageTitle>@L["Sellers"] — Treba Admin</PageTitle>

<section class="page-hero sellers-hero">
    <div>
        <p class="eyebrow">@L["PartnerNetwork"]</p>
        <h1>@L["SellersManagement"]</h1>
    </div>
</section>

@if (_loading)
{
    <section class="card-box workspace-empty" role="status"><div class="spinner-border text-warning" aria-hidden="true"></div><p>@L["Loading"]</p></section>
}
else if (_loadFailed)
{
    <section class="card-box workspace-empty" role="alert">
        <span class="workspace-empty-icon"><i class="bi bi-exclamation-triangle"></i></span>
        <h2>@L["SellerLoadFailed"]</h2>
        <button class="secondary-button" type="button" @onclick="LoadAsync">@L["TryAgain"]</button>
    </section>
}
else
{
    <section class="seller-summary-strip" aria-label="@L["SellersManagement"]">
        <div><span class="summary-icon green"><i class="bi bi-patch-check"></i></span><p><strong>@CountByStatus(1)</strong><span>@L["VerifiedSellers"]</span></p></div>
        <div><span class="summary-icon amber"><i class="bi bi-hourglass-split"></i></span><p><strong>@CountByStatus(0)</strong><span>@L["PendingReview"]</span></p></div>
        <div><span class="summary-icon red"><i class="bi bi-pause-circle"></i></span><p><strong>@CountByStatus(2)</strong><span>@L["Suspended"]</span></p></div>
        <div><span class="summary-icon blue"><i class="bi bi-shop"></i></span><p><strong>@_sellers.Count</strong><span>@L["AllSellers"]</span></p></div>
    </section>

    <section class="seller-board">
        <div class="seller-board-header">
            <div class="filter-pills" role="group" aria-label="@L["Status"]">
                <button class="filter-pill @FilterClass(null)" type="button" @onclick="() => SetStatus(null)">@L["All"]</button>
                <button class="filter-pill @FilterClass(0)" type="button" @onclick="() => SetStatus(0)">@L["Applications"]</button>
                <button class="filter-pill @FilterClass(1)" type="button" @onclick="() => SetStatus(1)">@L["Verified"]</button>
                <button class="filter-pill @FilterClass(2)" type="button" @onclick="() => SetStatus(2)">@L["Suspended"]</button>
                <button class="filter-pill @FilterClass(3)" type="button" @onclick="() => SetStatus(3)">@L["Rejected"]</button>
            </div>
            <label class="workspace-search seller-search">
                <i class="bi bi-search"></i>
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="@L["SellerSearchByName"]" aria-label="@L["Search"]" />
            </label>
        </div>

        @if (FilteredSellers.Count == 0)
        {
            <div class="workspace-empty" role="status">
                <span class="workspace-empty-icon"><i class="bi bi-shop"></i></span>
                <h2>@L["SellersNotFound"]</h2>
                <p>@L["SellersNotFoundDesc"]</p>
            </div>
        }
        else
        {
            <div class="seller-grid">
                @foreach (var seller in FilteredSellers)
                {
                    <article class="seller-card">
                        <div class="seller-card-top">
                            <div class="seller-logo orange">@Initials(seller.CompanyName)</div>
                            <span class="status-badge @StatusClass(seller.Status)">@StatusLabel(seller.Status)</span>
                        </div>
                        <h2>@seller.CompanyName</h2>
                        <p>@(string.IsNullOrWhiteSpace(seller.Description) ? L["SellerDescriptionMissing"].Value : seller.Description)</p>
                        <dl class="seller-card-details">
                            <div><dt>@L["TaxId"]</dt><dd>@seller.TaxNumber</dd></div>
                            @if (!string.IsNullOrWhiteSpace(seller.Email)) { <div><dt>Email</dt><dd>@seller.Email</dd></div> }
                            @if (!string.IsNullOrWhiteSpace(seller.Phone)) { <div><dt>@L["Phone"]</dt><dd>@seller.Phone</dd></div> }
                        </dl>
                        <div class="seller-card-footer">
                            <span>@L["Since"] @seller.CreatedAt.ToString("d", CultureInfo.CurrentCulture)</span>
                            <a href="@($"/sellers/review/{seller.Id}")">@L["OpenProfile"] <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<SellerDto> _sellers = [];
    private string _search = string.Empty;
    private int? _status;
    private bool _loading = true;
    private bool _loadFailed;

    private IReadOnlyList<SellerDto> FilteredSellers => _sellers
        .Where(seller => (_status is null || seller.Status == _status)
            && (string.IsNullOrWhiteSpace(_search)
                || seller.CompanyName.Contains(_search, StringComparison.CurrentCultureIgnoreCase)
                || (seller.Email?.Contains(_search, StringComparison.CurrentCultureIgnoreCase) ?? false)
                || seller.TaxNumber.Contains(_search, StringComparison.CurrentCultureIgnoreCase)))
        .ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try { _sellers = await SellersApi.GetSellersAsync(); }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            _loadFailed = true;
            _sellers = [];
        }
        finally { _loading = false; }
    }

    private int CountByStatus(int status) => _sellers.Count(seller => seller.Status == status);
    private void SetStatus(int? status) => _status = status;
    private string FilterClass(int? status) => _status == status ? "active" : string.Empty;
    private string StatusLabel(int status) => status switch
    {
        0 => L["PendingReview"], 1 => L["Verified"], 2 => L["Suspended"], 3 => L["Rejected"], _ => L["NotSpecified"]
    };
    private static string StatusClass(int status) => status switch
    {
        1 => "badge-active", 2 or 3 => "badge-deleted", _ => "badge-pending"
    };
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
