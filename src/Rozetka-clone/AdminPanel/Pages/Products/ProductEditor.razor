@page "/products/new"

<PageTitle>@L["NewProduct"] — Treba Admin</PageTitle>
<section class="page-hero"><div><a class="back-link" href="/products"><i class="bi bi-arrow-left"></i>@L["BackToProducts"]</a><p class="eyebrow">@L["Catalog"]</p><h1>@L["NewProduct"]</h1></div><div class="editor-top-actions"><button class="secondary-button" type="button">@L["SaveDraft"]</button><button class="primary-button" type="button">@L["PublishProduct"]</button></div></section>

<div class="product-editor-layout">
    <main class="product-editor-main">
        <section class="card-box editor-section"><div class="editor-section-heading"><span>01</span><div><h2>@L["BasicInformation"]</h2><p>@L["BasicInformationDesc"]</p></div></div><div class="editor-form-grid"><label class="field-group editor-full"><span>@L["ProductName"] *</span><input class="form-control" placeholder="@L["ProductNamePlaceholder"]" /></label><label class="field-group"><span>@L["Category"] *</span><select class="form-control"><option>@L["SelectCategory"]</option></select></label><label class="field-group"><span>@L["Brand"]</span><input class="form-control" placeholder="Apple, Samsung..." /></label><label class="field-group"><span>SKU *</span><input class="form-control" placeholder="TRB-000001" /></label><label class="field-group"><span>@L["Seller"] *</span><select class="form-control"><option>@L["SelectSeller"]</option></select></label><label class="field-group editor-full"><span>@L["Description"]</span><textarea class="form-control" rows="5" placeholder="@L["ProductDescriptionPlaceholder"]"></textarea></label></div></section>
        <section class="card-box editor-section"><div class="editor-section-heading"><span>02</span><div><h2>@L["Media"]</h2><p>@L["MediaDesc"]</p></div></div><div class="media-uploader"><i class="bi bi-cloud-arrow-up"></i><strong>@L["DropProductImages"]</strong><p>PNG, JPG, WEBP · @L["UpTo"] 10 MB</p><button class="secondary-button" type="button">@L["ChooseFiles"]</button></div></section>
        <section class="card-box editor-section"><div class="editor-section-heading"><span>03</span><div><h2>@L["CharacteristicsAndVariants"]</h2><p>@L["CharacteristicsAndVariantsDesc"]</p></div></div><div class="editor-tabs"><button class="active" type="button">@L["Characteristics"]</button><button type="button">@L["Variants"]</button><button type="button">@L["Accessories"]</button><button type="button">@L["Services"]</button></div><div class="attribute-row"><input class="form-control" aria-label="@L["CharacteristicName"]" value="Матеріал"/><input class="form-control" aria-label="@L["CharacteristicValue"]" value="Алюміній"/><button type="button" aria-label="@L["DeleteCharacteristic"]"><i class="bi bi-trash"></i></button></div><div class="attribute-row"><input class="form-control" aria-label="@L["CharacteristicName"]" value="Гарантія"/><input class="form-control" aria-label="@L["CharacteristicValue"]" value="24 місяці"/><button type="button" aria-label="@L["DeleteCharacteristic"]"><i class="bi bi-trash"></i></button></div><button class="add-attribute" type="button"><i class="bi bi-plus"></i>@L["AddCharacteristic"]</button></section>
    </main>
    <aside class="product-editor-side"><section class="card-box editor-section"><div class="editor-section-heading compact"><span>₴</span><div><h2>@L["PriceAndStock"]</h2></div></div><label class="field-group"><span>@L["Price"] *</span><div class="money-input"><input class="form-control" value="0"/><b>₴</b></div></label><label class="field-group"><span>@L["OldPrice"]</span><div class="money-input"><input class="form-control" value="0"/><b>₴</b></div></label><label class="field-group"><span>@L["Stock"] *</span><input class="form-control" value="0"/></label><label class="editor-check"><input type="checkbox"/>@L["MarkAsPromotion"]</label></section><section class="card-box editor-tip"><i class="bi bi-lightbulb"></i><div><strong>@L["StorefrontTip"]</strong><p>@L["StorefrontTipDesc"]</p></div></section></aside>
</div>
