@page "/products"
@inject AdminPanel.Services.Implementations.CatalogApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Contracts.Catalog
@using System.Security.Claims

<PageTitle>@L["Products"] — Treba Admin</PageTitle>
<section class="page-hero storefront-blue-hero">
    <div><p class="eyebrow">@L["CatalogWorkspace"]</p><h1>@L["ProductManagement"]</h1><p>@L["ProductsSubtitle"]</p></div>
    @if (_canEdit) { <a class="storefront-action" href="/products/new"><i class="bi bi-plus-lg"></i>@L["AddProduct"]</a> }
</section>
@if (stats is not null)
{
    <section class="store-kpi-grid">
        <article><span class="store-kpi-icon blue"><i class="bi bi-box2"></i></span><div><small>@L["AllProducts"]</small><strong>@stats.Total</strong></div></article>
        <article><span class="store-kpi-icon green"><i class="bi bi-check-circle"></i></span><div><small>@L["Published"]</small><strong>@stats.Active</strong></div></article>
        <article><span class="store-kpi-icon amber"><i class="bi bi-hourglass-split"></i></span><div><small>@L["Moderation"]</small><strong>@stats.Pending</strong></div></article>
        <article><span class="store-kpi-icon orange"><i class="bi bi-pencil-square"></i></span><div><small>@L["Drafts"]</small><strong>@stats.Drafts</strong></div></article>
    </section>
}
<section class="card-box product-catalog-card">
    <form class="store-toolbar" @onsubmit="Search" @onsubmit:preventDefault>
        <label class="workspace-search"><i class="bi bi-search"></i><input aria-label="@L["ProductSearchAria"]" placeholder="@L["ProductSearchPlaceholder"]" @bind="search" /></label>
        <select class="form-control catalog-filter" aria-label="@L["Status"]" @bind="status"><option value="">@L["AllStatuses"]</option><option value="ACTIVE">@L["PublishedPlural"]</option><option value="DRAFT">@L["Drafts"]</option><option value="PENDING_MODERATION">@L["PendingModeration"]</option><option value="REJECTED">@L["RejectedPlural"]</option></select>
        <button class="secondary-button" type="submit" disabled="@loading">@L["Search"]</button>
    </form>
    @if (error is not null) { <p class="feedback-error" role="alert">@error</p><button class="secondary-button" @onclick="Search">@L["Retry"]</button> }
    @if (loading) { <p class="empty-state" role="status">@L["LoadingCatalog"]</p> }
    else if (result is not null)
    {
        <div class="table-wrap"><table class="custom-table storefront-products-table"><thead><tr><th>@L["Product"]</th><th>@L["Category"]</th><th>@L["Brand"]</th><th>@L["Price"]</th><th>@L["Stock"]</th><th>@L["Status"]</th><th>@L["Actions"]</th></tr></thead><tbody>
        @foreach (var product in result.Content)
        {
            <tr><td><div class="catalog-product"><span class="product-thumb blue"><i class="bi bi-box-seam"></i></span><div><strong>@product.Name</strong><small>@product.Sku · @product.Slug</small></div></div></td>
                <td>@product.CategoryName</td><td>@product.BrandName</td><td><strong>₴ @product.Price.ToString("N2")</strong></td><td>@product.StockQuantity</td>
                <td><span class="status-badge @(product.Status == "ACTIVE" ? "badge-paid" : "badge-pending")">@StatusLabel(product.Status)</span></td>
                <td>@if (_canEdit && product.Status is ("DRAFT" or "REJECTED" or "ACTIVE")) { <a class="btn-link-action" href="@($"/products/{product.Id}/edit")">@L["Edit"]</a> } else if (_canModerate) { <a class="btn-link-action" href="/moderation">@L["View"]</a> } else { <span>—</span> }</td></tr>
        }
        </tbody></table></div>
        @if (result.Content.Count == 0) { <div class="empty-state"><i class="bi bi-search"></i><h2>@L["ProductsNotFound"]</h2><p>@L["ProductsNotFoundDesc"]</p></div> }
        <div class="catalog-pagination"><span>@L["Found"]: @result.TotalElements</span><PaginationControl CurrentPage="result.Page" TotalPages="Math.Max(1,result.TotalPages)" OnPageChanged="Load" /></div>
    }
</section>
@code {
    private PagedResponse<CatalogProductDto>? result;
    private CatalogStatsDto? stats;
    private string search = "", status = "";
    private string? error;
    private bool loading;
    private bool _canEdit, _canModerate;
    protected override async Task OnInitializedAsync()
    {
        var role = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.Role)?.Value;
        _canEdit = AdminAccess.CanAccess(role, "/products/new");
        _canModerate = AdminAccess.CanAccess(role, "/moderation");
        await Load(1);
    }
    private Task Search() => Load(1);
    private async Task Load(int page)
    {
        loading = true; error = null;
        try { result = await Api.List(page, search, status); stats = await Api.Stats(); }
        catch (HttpRequestException ex) { error = ex.Message; }
        finally { loading = false; }
    }
    private string StatusLabel(string status) => status switch { "ACTIVE" => L["Published"], "DRAFT" => L["Drafts"], "PENDING_MODERATION" => L["PendingModeration"], "REJECTED" => L["RejectedPlural"], _ => status };
}
