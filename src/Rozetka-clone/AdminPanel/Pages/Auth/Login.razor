@page "/auth/login"
@layout AuthLayout
@inject HttpClient Http
@inject JwtAuthenticationStateProvider Auth
@inject TokenStorageService Tokens
@inject NavigationManager Navigation
@using Contracts.Authentication
@using System.ComponentModel.DataAnnotations
@using System.Text.Json

<PageTitle>@L["Login"] — Treba Admin</PageTitle>
<section class="login-shell">
    <div class="login-brand-panel">
        <div class="login-brand"><span>T</span><div><strong>TREBA</strong><small>@L["AdminPanel"]</small></div></div>
        <div class="login-brand-copy"><p class="eyebrow">@L["SecureWorkspace"]</p><h1>@L["OperateWithClarity"]</h1></div>
        <div class="login-security-note"><i class="bi bi-shield-check"></i><div><strong>@L["ProtectedAccess"]</strong><span>@L["LoginAreas"]</span></div></div>
        <div class="login-orbit orbit-one"></div><div class="login-orbit orbit-two"></div>
    </div>
    <div class="login-form-panel"><div class="login-form-wrap">
        @if (_stage == LoginStage.Credentials)
        {
            <p class="eyebrow">@L["WelcomeBack"]</p><h2>@L["StaffSignIn"]</h2><p class="login-intro">@L["LoginIntro"]</p>
            @if (_error is not null) { <p class="feedback-error" role="alert">@_error</p> }
            <EditForm Model="_credentials" OnValidSubmit="SignInAsync" FormName="admin-login" class="login-form">
                <DataAnnotationsValidator /><ValidationSummary />
                <label><span>@L["StaffEmail"]</span><div class="login-input"><i class="bi bi-envelope"></i><InputText type="email" autocomplete="username" @bind-Value="_credentials.Email" /></div></label>
                <label><span>@L["Password"]</span><div class="login-input"><i class="bi bi-lock"></i><InputText type="password" autocomplete="current-password" @bind-Value="_credentials.Password" /></div></label>
                <button class="primary-button wide login-submit" type="submit" disabled="@_busy">@(_busy ? L["LoginInProgress"] : L["SignIn"])<i class="bi bi-arrow-right"></i></button>
            </EditForm>
        }
        else if (_stage == LoginStage.ChooseMethod)
        {
            <button class="login-back" type="button" @onclick="Reset"><i class="bi bi-arrow-left"></i> @L["Back"]</button>
            <div class="login-step-icon"><i class="bi bi-shield-lock"></i></div>
            <p class="eyebrow">@L["TwoFactorAuth"]</p><h2>@L["ChooseVerificationMethod"]</h2><p class="login-intro">@L["ChooseVerificationMethodDesc"]</p>
            @if (_error is not null) { <p class="feedback-error" role="alert">@_error</p> }
            <div class="login-methods">
                @if (_challenge?.Methods.Contains(TwoFactorMethods.Authenticator) == true)
                {
                    <button type="button" class="login-method" @onclick="() => SelectMethodAsync(TwoFactorMethods.Authenticator)" disabled="@_busy"><span><i class="bi bi-phone"></i></span><div><strong>Google Authenticator</strong><small>@L["AuthenticatorMethodDesc"]</small></div><i class="bi bi-chevron-right"></i></button>
                }
                @if (_challenge?.Methods.Contains(TwoFactorMethods.Email) == true)
                {
                    <button type="button" class="login-method" @onclick="() => SelectMethodAsync(TwoFactorMethods.Email)" disabled="@_busy"><span><i class="bi bi-envelope-check"></i></span><div><strong>@L["EmailCode"]</strong><small>@_challenge.MaskedEmail</small></div><i class="bi bi-chevron-right"></i></button>
                }
            </div>
        }
        else
        {
            <button class="login-back" type="button" @onclick="BackToMethods"><i class="bi bi-arrow-left"></i> @L["ChooseAnotherMethod"]</button>
            <div class="login-step-icon"><i class="bi @(_selectedMethod == TwoFactorMethods.Email ? "bi-envelope-check" : "bi-phone")"></i></div>
            <p class="eyebrow">@L["IdentityVerification"]</p><h2>@L["EnterSecurityCode"]</h2>
            <p class="login-intro">@(_selectedMethod == TwoFactorMethods.Email ? string.Format(L["EmailCodeSent"], _challenge?.MaskedEmail) : L["AuthenticatorCodeHint"])</p>
            @if (_error is not null) { <p class="feedback-error" role="alert">@_error</p> }
            <EditForm Model="_code" OnValidSubmit="VerifyAsync" FormName="two-factor-login" class="login-form">
                <DataAnnotationsValidator />
                <label><span>@L["SecurityCode"]</span><InputText class="login-code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind-Value="_code.Value" /></label>
                <button class="primary-button wide login-submit" type="submit" disabled="@_busy">@(_busy ? L["Verifying"] : L["VerifyAndSignIn"])<i class="bi bi-arrow-right"></i></button>
            </EditForm>
            @if (_selectedMethod == TwoFactorMethods.Email)
            {
                <button class="login-resend" type="button" @onclick="SendEmailCodeAsync" disabled="@_busy">@L["SendCodeAgain"]</button>
            }
        }
    </div></div>
</section>

@code {
    private readonly LoginModel _credentials = new();
    private readonly CodeModel _code = new();
    private LoginStage _stage;
    private TwoFactorChallengeResponse? _challenge;
    private string? _selectedMethod;
    private bool _busy;
    private string? _error;

    private async Task SignInAsync()
    {
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/login", new LoginRequest(_credentials.Email, _credentials.Password));
            if (!response.IsSuccessStatusCode) { _error = L["LoginFailed"]; return; }
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (result?.Authentication is not null) { await CompleteLoginAsync(result.Authentication); return; }
            if (result?.Challenge is null) { _error = L["LoginFailed"]; return; }
            _challenge = result.Challenge;
            _stage = LoginStage.ChooseMethod;
        }
        catch (HttpRequestException) { _error = L["ApiUnavailable"]; }
        finally { _busy = false; }
    }

    private async Task SelectMethodAsync(string method)
    {
        _selectedMethod = method; _error = null; _code.Value = string.Empty;
        if (method == TwoFactorMethods.Email && !await SendEmailCodeAsync()) return;
        _stage = LoginStage.Code;
    }

    private async Task<bool> SendEmailCodeAsync()
    {
        if (_challenge is null) return false;
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/2fa/email/send", new SendEmailLoginCodeRequest(_challenge.ChallengeId));
            if (!response.IsSuccessStatusCode) { _error = await ReadErrorAsync(response, L["EmailCodeSendFailed"]); return false; }
            return true;
        }
        catch (HttpRequestException) { _error = L["ApiUnavailable"]; return false; }
        finally { _busy = false; }
    }

    private async Task VerifyAsync()
    {
        if (_challenge is null || _selectedMethod is null) return;
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/2fa/verify", new VerifyLoginSecondFactorRequest(_challenge.ChallengeId, _selectedMethod, _code.Value));
            if (!response.IsSuccessStatusCode) { _error = L["InvalidSecurityCode"]; return; }
            var auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (auth is null) { _error = L["LoginFailed"]; return; }
            await CompleteLoginAsync(auth);
        }
        catch (HttpRequestException) { _error = L["ApiUnavailable"]; }
        finally { _busy = false; }
    }

    private async Task CompleteLoginAsync(AuthResponse auth)
    {
        if (!AdminAccess.IsStaff(auth.Role)) { _error = L["StaffAccountRequired"]; return; }
        await Tokens.SetRefreshTokenAsync(auth.RefreshToken);
        await Auth.NotifyUserAuthenticationAsync(auth.AccessToken);
        Navigation.NavigateTo("/");
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            return json.RootElement.TryGetProperty("message", out var node) ? node.GetString() ?? fallback : fallback;
        }
        catch (JsonException) { return fallback; }
    }

    private void BackToMethods() { _stage = LoginStage.ChooseMethod; _error = null; _code.Value = string.Empty; }
    private void Reset() { _stage = LoginStage.Credentials; _challenge = null; _error = null; _credentials.Password = string.Empty; }
    private enum LoginStage { Credentials, ChooseMethod, Code }
    private sealed class LoginModel { [Required, EmailAddress] public string Email { get; set; } = ""; [Required] public string Password { get; set; } = ""; }
    private sealed class CodeModel { [Required, RegularExpression("^[0-9]{6}$")] public string Value { get; set; } = ""; }
}
