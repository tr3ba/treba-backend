@page "/"
@inject AdminPanel.Services.Implementations.CatalogApiClient CatalogApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Contracts.Catalog
@using System.Security.Claims

<PageTitle>@L["Dashboard"] — Treba Admin</PageTitle>

<section class="dashboard-header">
    <div><p class="eyebrow">@L["CatalogWorkspace"]</p><h1>@L["Dashboard"]</h1></div>
    @if (CanModerate) { <a class="dashboard-primary-action" href="/moderation"><i class="bi bi-box-seam"></i>@L["GoToModeration"]</a> }
</section>

@if (_loadFailed)
{
    <p class="feedback-error" role="alert">@L["CatalogStatsUnavailable"]</p>
}

<section class="stats-grid" aria-label="@L["KeyMetrics"]">
    <article class="stat-card"><div class="stat-info"><p class="stat-title">@L["AllProducts"]</p><p class="stat-value">@(_stats?.Total.ToString() ?? "—")</p></div><div class="stat-icon icon-blue"><i class="bi bi-box2"></i></div></article>
    <article class="stat-card"><div class="stat-info"><p class="stat-title">@L["Published"]</p><p class="stat-value">@(_stats?.Active.ToString() ?? "—")</p></div><div class="stat-icon icon-green"><i class="bi bi-check-circle"></i></div></article>
    <article class="stat-card"><div class="stat-info"><p class="stat-title">@L["Drafts"]</p><p class="stat-value">@(_stats?.Drafts.ToString() ?? "—")</p></div><div class="stat-icon icon-orange"><i class="bi bi-pencil-square"></i></div></article>
    <article class="stat-card"><div class="stat-info"><p class="stat-title">@L["InModeration"]</p><p class="stat-value">@(_stats?.Pending.ToString() ?? "—")</p></div><div class="stat-icon icon-amber"><i class="bi bi-shield-check"></i></div></article>
</section>

<section class="section-grid dashboard-shortcuts">
    <article class="card-box">
        <div class="card-box-header"><h2 class="card-box-title">@L["ProductManagement"]</h2></div>
        <p>@L["ProductsSubtitle"]</p>
        <a class="btn-link-action" href="/products">@L["AllProducts"] <i class="bi bi-arrow-right"></i></a>
    </article>
    @if (CanModerate)
    {
        <article class="card-box">
            <div class="card-box-header"><h2 class="card-box-title">@L["ModerationQueue"]</h2></div>
            <p>@L["ModerationSubtitle"]</p>
            <a class="btn-link-action" href="/moderation">@L["GoToModeration"] <i class="bi bi-arrow-right"></i></a>
        </article>
    }
</section>

@code {
    private CatalogStatsDto? _stats;
    private bool _loadFailed;
    private string? _role;
    private bool CanModerate => AdminAccess.CanAccess(_role, "/moderation");

    protected override async Task OnInitializedAsync()
    {
        _role = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.Role)?.Value;
        try { _stats = await CatalogApi.Stats(); }
        catch (HttpRequestException) { _loadFailed = true; }
    }
}
