@page "/support/trash"
@inject OperationsApiClient Api
@inject NavigationManager Nav
@inject UiTime Time

<PageTitle>@L["ChatTrash"] — TREBA</PageTitle>
<a class="users-back-link" href="/support"><i class="bi bi-arrow-left"></i>@L["SupportAndReturns"]</a>
<section class="page-hero"><div class="page-title-with-icon"><span class="page-title-icon"><i class="bi bi-trash3" aria-hidden="true"></i></span><div><p class="eyebrow">@L["SupportAndReturns"]</p><h1>@L["ChatTrash"]</h1><p>@L["ChatTrashHint"]</p></div></div></section>
<section class="card-box">
    <form class="feature-trash-search" @onsubmit="Search" @onsubmit:preventDefault><label class="field-group"><span>@L["Search"]</span><input class="form-control" @bind="_search" maxlength="200" placeholder="@O["TicketSearch"]" /></label><button class="secondary-button" disabled="@_busy"><i class="bi bi-search" aria-hidden="true"></i>@L["Search"]</button></form>
    @if (_error is not null) { <p class="feedback-error" role="alert">@_error</p> }
    @if (_loading) { <p class="empty-state" role="status">@L["Loading"]</p> }
    else if (_result?.Content.Count == 0) { <div class="workspace-empty"><i class="bi bi-trash3" aria-hidden="true"></i><h2>@L["ChatTrashEmpty"]</h2></div> }
    else if (_result is not null)
    {
        <div class="table-wrap"><table class="custom-table"><thead><tr><th>@O["Subject"]</th><th>@L["ChatDeletedAt"]</th><th>@L["RestoreChat"]</th></tr></thead><tbody>
            @foreach (var row in _result.Content)
            {
                <tr @key="row.Id"><td><strong>@row.Subject</strong><p class="support-preview">@row.LastMessage</p><small>@row.CustomerName · @O["Kind_" + row.Kind]</small></td><td>@Time.Local(row.DeletedAt ?? row.UpdatedAt).ToString("g")</td><td><button class="secondary-button" disabled="@_busy" @onclick="() => _restoring = row"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>@L["RestoreChat"]</button></td></tr>
            }
        </tbody></table></div>
        <PaginationControl CurrentPage="_result.Page" TotalPages="_result.TotalPages" OnPageChanged="Load" />
    }
</section>
<ConfirmDialog IsOpen="@(_restoring is not null)" Title="@L["RestoreChat"]" Message="@L["RestoreChatConfirm"]" OnClose="Restore" />

@code {
    private PagedResponse<TicketRow>? _result;
    private TicketRow? _restoring;
    private string _search = "";
    private string? _error;
    private bool _loading = true, _busy;
    protected override Task OnInitializedAsync() => Load(1);
    private Task Search() => Load(1);
    private async Task Load(int page)
    {
        _loading = true; _error = null;
        try { _result = await Api.DeletedTickets(page, _search); }
        catch (HttpRequestException e) { _error = e.Message; }
        finally { _loading = false; }
    }
    private async Task Restore(bool yes)
    {
        var row = _restoring; _restoring = null;
        if (!yes || row is null || _busy) return;
        _busy = true; _error = null;
        try { await Api.RestoreTicket(row.Id, row.Version); Nav.NavigateTo("/support/" + row.Id); }
        catch (HttpRequestException e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
