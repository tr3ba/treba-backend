@page "/support"
@implements IAsyncDisposable
@inject OperationsApiClient Api
@inject NavigationManager Nav
@inject UiTime Time
@inject AuthenticationStateProvider Authentication

<PageTitle>@L["SupportAndReturns"] — Treba Admin</PageTitle>
<section class="page-hero">
    <div class="page-title-with-icon"><span class="page-title-icon"><i class="bi bi-chat-square-heart" aria-hidden="true"></i></span><div><p class="eyebrow">@L["CustomerCare"]</p><h1>@(role == "Seller" ? O["SellerQuestions"] : L["SupportCenter"])</h1><p>@O[role == "Seller" ? "SellerQueueHint" : "TrebaQueueHint"]</p></div></div>
    @if(CanCreate){<button type="button" class="primary-button" @onclick="() => creating = !creating"><i class="bi @(creating ? "bi-x-lg" : "bi-plus-lg")" aria-hidden="true"></i>@(creating ? L["Cancel"] : O["CreateTicket"])</button>}
</section>

<nav class="support-queue-tabs" aria-label="@L["SupportCenter"]">
    <a href="/support" class="@(string.IsNullOrEmpty(QueueView) ? "active" : "")" aria-current="@(string.IsNullOrEmpty(QueueView) ? "page" : null)"><i class="bi bi-inboxes" aria-hidden="true"></i>@O["InboxAll"]</a>
    <a href="/support?view=unread" class="@(QueueView == "unread" ? "active" : "")" aria-current="@(QueueView == "unread" ? "page" : null)"><i class="bi bi-envelope-paper" aria-hidden="true"></i>@O["InboxUnread"]</a>
    <a href="/support?view=open" class="@(QueueView == "open" ? "active" : "")" aria-current="@(QueueView == "open" ? "page" : null)"><i class="bi bi-chat-dots" aria-hidden="true"></i>@O["InboxOpen"]</a>
    <a href="/support?view=overdue" class="@(QueueView == "overdue" ? "active" : "")" aria-current="@(QueueView == "overdue" ? "page" : null)"><i class="bi bi-clock-history" aria-hidden="true"></i>@O["InboxOverdue"]</a>
</nav>

<section class="card-box support-filters">
    <form class="operations-toolbar" @onsubmit="Search" @onsubmit:preventDefault>
        <label class="field-group"><span>@L["Search"]</span><input class="form-control" @bind="search" placeholder="@O["TicketSearch"]" /></label>
        <label class="field-group"><span>@L["Status"]</span><select class="form-control" @bind="status"><option value="">@O["AllStatuses"]</option>@foreach(var state in OperationsUi.TicketStatuses){<option value="@state">@O["Ticket_" + state]</option>}</select></label>
        <label class="field-group"><span>@O["Kind"]</span><select class="form-control" @bind="kind"><option value="">@O["All"]</option>@if(role != "Seller"){<option value="CHAT">@O["Kind_CHAT"]</option>}@if(role != "Moderator"){<option value="QUESTION">@O["Kind_QUESTION"]</option>}@if(CanCreate){<option value="RETURN">@O["Kind_RETURN"]</option>}</select></label>
        <button class="secondary-button" disabled="@loading"><i class="bi bi-search" aria-hidden="true"></i>@L["Search"]</button>
    </form>
</section>
@if(error is not null){<p class="feedback-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@error <button class="secondary-button" @onclick="() => Load(page)"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>@L["TryAgain"]</button></p>}
@if(creating && CanCreate)
{
    <section class="card-box support-create-card">
        <h2><i class="bi bi-pencil-square" aria-hidden="true"></i>@O["CreateTicket"]</h2>
        <div class="operations-toolbar"><label class="field-group"><span>@O["FindOrder"]</span><input class="form-control" @bind="orderSearch" /></label><button class="secondary-button" type="button" @onclick="FindOrders" disabled="@busy"><i class="bi bi-search" aria-hidden="true"></i>@L["Search"]</button></div>
        <EditForm Model="model" OnValidSubmit="Create" FormName="support-create">
            <DataAnnotationsValidator /><ValidationSummary />
            <div class="operations-form-grid">
                <label class="field-group"><span>@O["OrderNumber"] *</span><InputSelect class="form-control" @bind-Value="model.OrderId"><option value="@Guid.Empty">@O["Choose"]</option>@foreach(var order in orderOptions){<option value="@order.Id">@order.OrderNumber · @order.CustomerName</option>}</InputSelect></label>
                <label class="field-group"><span>@O["Kind"]</span><InputSelect class="form-control" @bind-Value="model.Kind"><option value="QUESTION">@O["Kind_QUESTION"]</option><option value="RETURN">@O["Kind_RETURN"]</option></InputSelect></label>
            </div>
            <label class="field-group"><span>@O["Subject"] *</span><InputText class="form-control" maxlength="200" @bind-Value="model.Subject" /></label>
            <label class="field-group"><span>@O["Message"] *</span><InputTextArea class="form-control" rows="4" maxlength="4000" @bind-Value="model.Message" /></label>
            <p class="operations-caption">@O["FullReturnHint"]</p>
            <button class="primary-button" disabled="@(busy || !model.OrderId.HasValue || model.OrderId == Guid.Empty)"><i class="bi bi-plus-lg" aria-hidden="true"></i>@O["CreateTicket"]</button>
        </EditForm>
    </section>
}
<section class="card-box support-inbox">
    @if(loading){<div class="workspace-empty" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i><p>@L["Loading"]</p></div>}
    else if(result is not null)
    {
        <div class="support-inbox-heading"><h2><i class="bi bi-inbox" aria-hidden="true"></i>@O["Inbox"]</h2><span>@O["ResultCount", result.TotalElements]</span></div>
        @if(result.Content.Count == 0){<div class="workspace-empty"><i class="bi bi-inbox" aria-hidden="true"></i><h2>@O["NoResults"]</h2></div>}
        else
        {
            <div class="table-wrap"><table class="custom-table support-inbox-table">
                <thead><tr><th>@O["Subject"]</th><th>@O["Kind"]</th><th>@L["Status"]</th><th>@O["Updated"]</th><th><span class="visually-hidden">@L["Open"]</span></th></tr></thead>
                <tbody>@foreach(var t in result.Content)
                {
                    <tr class="@(t.UnreadCount > 0 ? "inbox-row-unread" : "")">
                        <td><div class="inbox-identity"><span class="inbox-avatar"><i class="bi @(t.Kind == "CHAT" ? "bi-chat-dots" : t.Kind == "RETURN" ? "bi-arrow-return-left" : "bi-box-seam")" aria-hidden="true"></i></span><div class="inbox-summary"><div class="inbox-subject"><a class="record-link" href="@($"/support/{t.Id}")">@t.Subject</a>@if(t.UnreadCount > 0){<span class="inbox-unread" aria-label="@($"{O["UnreadMessages"]}: {t.UnreadCount}")">@t.UnreadCount</span>}</div><small class="support-preview">@t.LastMessage</small><div class="inbox-customer"><i class="bi bi-person" aria-hidden="true"></i>@t.CustomerName @if(t.OrderId.HasValue){<span>·</span><a class="record-link" href="@($"/orders/{t.OrderId}")">@t.OrderNumber</a>}else if(t.ProductId.HasValue){<span>·</span><span class="inbox-product">@t.ProductName</span>}</div></div></div></td>
                        <td><span class="support-kind" title="@O["Kind_" + t.Kind]">@O["KindShort_" + t.Kind]</span></td>
                        <td><OperationsStatusBadge Domain="Ticket" Value="@t.Status" /></td>
                        <td><time class="table-date" datetime="@t.UpdatedAt.ToString("O")">@Time.Local(t.UpdatedAt).ToString("g")</time></td>
                        <td><a class="icon-button" href="@($"/support/{t.Id}")" aria-label="@($"{L["Open"]}: {t.Subject}")"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></td>
                    </tr>
                }</tbody>
            </table></div>
        }
        <PaginationControl CurrentPage="result.Page" TotalPages="result.TotalPages" OnPageChanged="Load" />
    }
</section>
@code{private string? role;private bool CanCreate=>role is "Administrator" or "Manager";
protected override async Task OnInitializedAsync()=>role=(await Authentication.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
[SupplyParameterFromQuery]public Guid? OrderId{get;set;}[SupplyParameterFromQuery(Name="view")]public string? QueueView{get;set;}private bool loading,busy,creating;private string? error;private int page=1;private string search="",status="",kind="",orderSearch="";private CreateTicketRequest model=new();private IReadOnlyList<OrderRow> orderOptions=[];private PagedResponse<TicketRow>? result;
protected override async Task OnParametersSetAsync(){await Load(1);if(CanCreate&&OrderId.HasValue){try{var order=await Api.Order(OrderId.Value);orderOptions=[order.Summary];model.OrderId=OrderId.Value;creating=true;}catch(HttpRequestException e){error=e.Message;}}}
private Task Search()=>Load(1);private Task Load(int p)=>LoadCore(p,false);private async Task LoadCore(int p,bool silent){page=p;if(!silent)loading=true;try{result=await Api.Tickets(p,status,kind,search,QueueView);error=null;}catch(HttpRequestException e){error=e.Message;if(!silent)result=null;}finally{loading=false;}}
private async Task FindOrders(){busy=true;error=null;try{orderOptions=(await Api.Orders(search:orderSearch)).Content;}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}
private async Task Create(){busy=true;error=null;try{var ticket=await Api.CreateTicket(model);Nav.NavigateTo($"/support/{ticket.Summary.Id}");}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}
private readonly CancellationTokenSource lifetime=new();private Task? polling;
protected override Task OnAfterRenderAsync(bool firstRender){if(firstRender)polling=Poll();return Task.CompletedTask;}
private async Task Poll(){using var timer=new PeriodicTimer(TimeSpan.FromSeconds(5));try{while(await timer.WaitForNextTickAsync(lifetime.Token))if(!busy&&!loading)await InvokeAsync(()=>LoadCore(page,true));}catch(OperationCanceledException){}}
public async ValueTask DisposeAsync(){lifetime.Cancel();if(polling is not null)await polling;lifetime.Dispose();}
}
