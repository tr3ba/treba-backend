@page "/support"
@inject OperationsApiClient Api
@inject NavigationManager Nav
@inject UiTime Time

<PageTitle>@L["SupportAndReturns"] — Treba Admin</PageTitle>

<section class="page-hero">
    <div><p class="eyebrow">@L["CustomerCare"]</p><h1>@L["SupportCenter"]</h1></div>
</section>

@if(QueueView is "open" or "overdue"){<p class="operations-caption">@O[QueueView=="overdue"?"OverdueTickets":"OpenTickets"] · <a href="/support">@O["All"]</a></p>}
<section class="card-box"><form class="operations-toolbar" @onsubmit="Search" @onsubmit:preventDefault><label class="field-group"><span>@L["Search"]</span><input class="form-control" @bind="search" placeholder="@O["TicketSearch"]" /></label><label class="field-group"><span>@L["Status"]</span><select class="form-control" @bind="status"><option value="">@O["AllStatuses"]</option>@foreach(var state in OperationsUi.TicketStatuses){<option value="@state">@O["Ticket_"+state]</option>}</select></label><label class="field-group"><span>@O["Kind"]</span><select class="form-control" @bind="kind"><option value="">@O["All"]</option><option value="QUESTION">@O["Kind_QUESTION"]</option><option value="RETURN">@O["Kind_RETURN"]</option></select></label><button class="secondary-button" disabled="@loading">@L["Search"]</button><button type="button" class="primary-button" @onclick="()=>creating=!creating">@O["CreateTicket"]</button></form></section>
@if(error is not null){<p class="feedback-error" role="alert">@error <button class="secondary-button" @onclick="()=>Load(page)">@L["TryAgain"]</button></p>}
@if(creating){<section class="card-box"><h2>@O["CreateTicket"]</h2><div class="operations-toolbar"><label class="field-group"><span>@O["FindOrder"]</span><input class="form-control" @bind="orderSearch" /></label><button class="secondary-button" type="button" @onclick="FindOrders" disabled="@busy">@L["Search"]</button></div>
<EditForm Model="model" OnValidSubmit="Create" FormName="support-create"><DataAnnotationsValidator/><ValidationSummary/><div class="operations-form-grid"><label class="field-group"><span>@O["OrderNumber"] *</span><InputSelect class="form-control" @bind-Value="model.OrderId"><option value="@Guid.Empty">@O["Choose"]</option>@foreach(var order in orderOptions){<option value="@order.Id">@order.OrderNumber · @order.CustomerName</option>}</InputSelect></label><label class="field-group"><span>@O["Kind"]</span><InputSelect class="form-control" @bind-Value="model.Kind"><option value="QUESTION">@O["Kind_QUESTION"]</option><option value="RETURN">@O["Kind_RETURN"]</option></InputSelect></label></div><label class="field-group"><span>@O["Subject"] *</span><InputText class="form-control" maxlength="200" @bind-Value="model.Subject" /></label><label class="field-group"><span>@O["Message"] *</span><InputTextArea class="form-control" rows="4" maxlength="4000" @bind-Value="model.Message" /></label><p class="operations-caption">@O["FullReturnHint"]</p><button class="primary-button" disabled="@(busy||model.OrderId==Guid.Empty)">@O["CreateTicket"]</button></EditForm></section>}
<section class="card-box">@if(loading){<p class="empty-state">@L["Loading"]</p>}else if(result is not null){<div class="table-wrap"><table class="custom-table"><thead><tr><th>@O["Subject"]</th><th>@O["OrderNumber"]</th><th>@O["Kind"]</th><th>@L["Status"]</th><th>@O["Updated"]</th></tr></thead><tbody>@foreach(var t in result.Content){<tr><td><a href="@($"/support/{t.Id}")">@t.Subject</a><small class="operations-muted">@t.CustomerName</small></td><td><a href="@($"/orders/{t.OrderId}")">@t.OrderNumber</a></td><td>@O["Kind_"+t.Kind]</td><td>@O["Ticket_"+t.Status]</td><td>@Time.Local(t.UpdatedAt).ToString("g")</td></tr>}</tbody></table></div>@if(result.Content.Count==0){<p class="empty-state">@O["NoResults"]</p>}<PaginationControl CurrentPage="result.Page" TotalPages="result.TotalPages" OnPageChanged="Load" />}</section>
@code{[SupplyParameterFromQuery]public Guid? OrderId{get;set;}[SupplyParameterFromQuery(Name="view")]public string? QueueView{get;set;}private bool loading,busy,creating;private string? error;private int page=1;private string search="",status="",kind="",orderSearch="";private CreateTicketRequest model=new();private IReadOnlyList<OrderRow> orderOptions=[];private PagedResponse<TicketRow>? result;
protected override async Task OnParametersSetAsync(){await Load(1);if(OrderId.HasValue){try{var order=await Api.Order(OrderId.Value);orderOptions=[order.Summary];model.OrderId=OrderId.Value;creating=true;}catch(HttpRequestException e){error=e.Message;}}}
private Task Search()=>Load(1);private async Task Load(int p){page=p;loading=true;error=null;try{result=await Api.Tickets(p,status,kind,search,QueueView);}catch(HttpRequestException e){error=e.Message;result=null;}finally{loading=false;}}
private async Task FindOrders(){busy=true;error=null;try{orderOptions=(await Api.Orders(search:orderSearch)).Content;}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}
private async Task Create(){busy=true;error=null;try{var ticket=await Api.CreateTicket(model);Nav.NavigateTo($"/support/{ticket.Summary.Id}");}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}
}
