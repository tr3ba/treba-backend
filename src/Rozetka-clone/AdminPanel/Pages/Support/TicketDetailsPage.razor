@page "/support/{Id:guid}"
@inject OperationsApiClient Api
@inject UiTime Time
<PageTitle>@L["SupportAndReturns"] — Treba Admin</PageTitle>
<a href="/support" class="users-back-link">← @L["SupportAndReturns"]</a>
@if(error is not null){<p class="feedback-error" role="alert">@error</p>}
@if(loading){<p class="empty-state">@L["Loading"]</p>}
else if(ticket is not null){
<section class="page-hero"><div><p class="eyebrow">@O["Kind_"+ticket.Summary.Kind]</p><h1>@ticket.Summary.Subject</h1><p><a href="@($"/orders/{ticket.Summary.OrderId}")">@ticket.Summary.OrderNumber</a> · @ticket.Summary.CustomerName · @O["Ticket_"+ticket.Summary.Status]</p></div><button class="secondary-button" disabled="@busy" @onclick="Load">@L["RefreshData"]</button></section>
<div class="operations-two-column"><section class="card-box"><h2>@O["Conversation"]</h2><p class="operations-caption">@O["RecentMessages"]</p><ol class="operations-messages">@foreach(var m in ticket.Messages){<li class="@(m.Internal?"operations-internal":"")"><div><strong>@m.AuthorName</strong> · @L[m.AuthorRole] @if(m.Internal){<span class="status-badge">@O["InternalNote"]</span>}<time>@Time.Local(m.CreatedAt).ToString("g")</time></div><p class="operations-text">@m.Message</p></li>}</ol>
@if(ticket.Summary.Status!="CLOSED"){<form @onsubmit="Send" @onsubmit:preventDefault><label class="field-group"><span>@O["Message"]</span><textarea class="form-control" rows="4" maxlength="4000" @bind="message" @bind:event="oninput"></textarea></label><label class="operations-check"><input type="checkbox" @bind="internalNote"/> @O["InternalNoteHint"]</label><button class="primary-button" disabled="@(busy||string.IsNullOrWhiteSpace(message))">@O["SendMessage"]</button></form>}</section>
<section class="card-box"><h2>@O["ChangeStatus"]</h2>@if(ticket.AllowedStatuses.Count>0){<label class="field-group"><span>@O["NextStatus"]</span><select class="form-control" @bind="next"><option value="">@O["Choose"]</option>@foreach(var state in ticket.AllowedStatuses){<option value="@state">@O["Ticket_"+state]</option>}</select></label>@if(ticket.Summary.Kind=="RETURN"){<p class="operations-caption">@O["ReturnReceiptHint"]</p>}<button class="primary-button" disabled="@(busy||string.IsNullOrEmpty(next))" @onclick="()=>confirm=true">@L["Save"]</button>}else{<p>@O["NoActions"]</p>}</section></div>}
<ConfirmDialog IsOpen="confirm" Title="@O["ChangeStatus"]" Message="@(ticket?.Summary.Kind=="RETURN"&&ticket.Summary.Status=="APPROVED"&&next=="CLOSED"?O["ConfirmReturnReceived"]:O["ConfirmStatus"])" OnClose="Confirm" />
@code{[Parameter]public Guid Id{get;set;}private TicketDetails? ticket;private bool loading,busy,confirm,internalNote;private string? error;private string message="",next="";protected override Task OnParametersSetAsync()=>Load();private async Task Load(){loading=true;error=null;try{ticket=await Api.Ticket(Id);next="";}catch(HttpRequestException e){error=e.Message;}finally{loading=false;}}
private async Task Send(){busy=true;error=null;try{await Api.Message(Id,new(message,internalNote));message="";internalNote=false;await Load();}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}
private async Task Confirm(bool yes){confirm=false;if(!yes||ticket is null)return;busy=true;error=null;try{await Api.ChangeTicket(Id,new(next,ticket.Summary.Version));await Load();}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}}
