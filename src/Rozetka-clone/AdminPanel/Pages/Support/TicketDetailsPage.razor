@page "/support/{Id:guid}"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject OperationsApiClient Api
@inject UiTime Time
@inject IJSRuntime Js
@inject AuthenticationStateProvider Authentication

<PageTitle>@L["SupportAndReturns"] — Treba Admin</PageTitle>
<a href="/support" class="users-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>@L["SupportAndReturns"]</a>
@if(error is not null){<p class="feedback-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@error <button class="secondary-button" @onclick="() => Load()">@L["TryAgain"]</button></p>}
@if(loading){<p class="empty-state" role="status">@L["Loading"]</p>}
else if(ticket is not null)
{
    <section class="page-hero support-case-hero"><div><p class="eyebrow">@O["Kind_" + ticket.Summary.Kind]</p><h1>@ticket.Summary.Subject</h1><div class="support-case-meta"><span><i class="bi bi-person" aria-hidden="true"></i>@ticket.Summary.CustomerName</span><OperationsStatusBadge Domain="Ticket" Value="@ticket.Summary.Status" /></div></div><button class="secondary-button" disabled="@busy" @onclick="() => Load()"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>@L["RefreshData"]</button></section>
    <div class="support-workspace">
        <section class="card-box support-conversation">
            <header><div class="support-thread-heading"><span class="support-thread-icon"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span><div><h2>@O["Conversation"]</h2><span class="support-live"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>@O["AutoRefreshChat"]</span></div></div><span class="support-kind">@O["Kind_" + ticket.Summary.Kind]</span></header>
            @if(hasEarlier){<div class="support-earlier"><button class="secondary-button" disabled="@busy" @onclick="Earlier"><i class="bi bi-clock-history" aria-hidden="true"></i>@O["EarlierMessages"]</button></div>}
            <ol id="support-message-history" class="support-bubbles" aria-label="@O["Conversation"]" aria-live="polite">
                @foreach(var m in messages)
                {
                    <li @key="m.Id" class="@(m.Internal ? "support-note" : m.AuthorRole == "Customer" ? "support-customer" : "support-staff")">
                        <div class="support-message-meta"><i class="bi @(m.Internal ? "bi-lock" : m.AuthorRole == "Customer" ? "bi-person-circle" : "bi-headset")" aria-hidden="true"></i><strong>@m.AuthorName</strong><span>@L[m.AuthorRole]</span>@if(m.Internal){<span class="support-note-label">@O["InternalNote"]</span>}</div>
                        <p class="operations-text">@m.Message</p><time datetime="@m.CreatedAt.ToString("O")">@Time.Local(m.CreatedAt).ToString("g")</time>
                    </li>
                }
            </ol>
            @if(ticket.Summary.Status != "CLOSED")
            {
                <form class="support-composer @(internalNote ? "is-internal" : "")" @onsubmit="Send" @onsubmit:preventDefault>
                    <label class="field-group"><span><i class="bi @(internalNote ? "bi-lock" : "bi-reply")" aria-hidden="true"></i>@(internalNote ? O["InternalNote"] : O["ReplyToCustomer"])</span><textarea class="form-control" rows="4" maxlength="4000" @bind="message" @bind:event="oninput" disabled="@busy"></textarea></label>
                    <div class="support-composer-actions"><div>@if(role is "Administrator" or "Manager" or "Moderator"){<label class="operations-check"><input type="checkbox" @bind="internalNote" disabled="@busy" />@O["InternalNoteHint"]</label>}<span class="support-character-count">@message.Length / 4000</span></div><button class="primary-button" disabled="@(busy || string.IsNullOrWhiteSpace(message))"><i class="bi bi-send" aria-hidden="true"></i>@O["SendReply"]</button></div>
                </form>
            }
            else{<div class="support-closed"><i class="bi bi-check2-circle" aria-hidden="true"></i>@O["ConversationClosed"]</div>}
        </section>
        <aside class="support-context">
            <section class="card-box support-context-card"><h2><i class="bi bi-info-circle" aria-hidden="true"></i>@O["ConversationContext"]</h2>
                <div class="support-context-item"><span class="support-context-icon"><i class="bi bi-person" aria-hidden="true"></i></span><div><small>@O["Customer"]</small>@if(AdminAccess.CanAccess(role, "/customer-activity")){<a class="record-link" href="@($"/customer-activity/{ticket.Summary.CustomerId}")">@ticket.Summary.CustomerName<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>}else{<strong>@ticket.Summary.CustomerName</strong>}</div></div>
                @if(ticket.Summary.OrderId.HasValue){<div class="support-context-item"><span class="support-context-icon"><i class="bi bi-bag-check" aria-hidden="true"></i></span><div><small>@O["OrderNumber"]</small><a class="record-link" href="@($"/orders/{ticket.Summary.OrderId}")">@ticket.Summary.OrderNumber<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div></div>}
                @if(ticket.Summary.ProductId.HasValue){<div class="support-context-item"><span class="support-context-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span><div><small>@O["Product"]</small><strong>@ticket.Summary.ProductName</strong></div></div>}
            </section>
            <section class="card-box support-context-card"><h2><i class="bi bi-arrow-left-right" aria-hidden="true"></i>@O["ChangeStatus"]</h2>
                @if(ticket.AllowedStatuses.Count > 0)
                {
                    <label class="field-group"><span>@O["NextStatus"]</span><select class="form-control" @bind="next"><option value="">@O["Choose"]</option>@foreach(var state in ticket.AllowedStatuses){<option value="@state">@O["Ticket_" + state]</option>}</select></label>
                    @if(ticket.Summary.Kind == "RETURN"){<p class="operations-caption">@O["ReturnReceiptHint"]</p>}
                    <button class="primary-button wide" disabled="@(busy || string.IsNullOrEmpty(next))" @onclick="() => confirm = true"><i class="bi bi-check2" aria-hidden="true"></i>@L["Save"]</button>
                }
                else{<p class="operations-caption">@O["NoActions"]</p>}
            </section>
        </aside>
    </div>
}
<ConfirmDialog IsOpen="confirm" Title="@O["ChangeStatus"]" Message="@(ticket?.Summary.Kind == "RETURN" && ticket.Summary.Status == "APPROVED" && next == "CLOSED" ? O["ConfirmReturnReceived"] : O["ConfirmStatus"])" OnClose="Confirm" />
@code {
    [Parameter] public Guid Id { get; set; }
    private TicketDetails? ticket;
    private List<TicketMessageView> messages = [];
    private bool loading, busy, confirm, internalNote, hasEarlier;
    private string? error;
    private string message = "", next = "", pendingText = "";
    private Guid pendingMessage, loadedId, readId;
    private Guid renderedMessage;
    private bool pendingInternal;
    private string? role;
    protected override async Task OnInitializedAsync() => role = (await Authentication.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    private readonly CancellationTokenSource lifetime = new();
    private Task? polling;
    protected override async Task OnParametersSetAsync() {
        if (loadedId != Id) { ticket = null; messages.Clear(); message = next = ""; readId = Guid.Empty; loadedId = Id; }
        await Load();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender)polling=Poll();
        if(messages.LastOrDefault() is {} last&&renderedMessage!=last.Id){renderedMessage=last.Id;await Js.InvokeVoidAsync("trebaSupport.latest","support-message-history");}
    }
    private async Task Poll() {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while(await timer.WaitForNextTickAsync(lifetime.Token)) if(!busy&&!confirm) await InvokeAsync(()=>Load(true)); }
        catch(OperationCanceledException) { }
    }
    private async Task Load(bool silent = false) {
        var id = Id; if(!silent)loading = true;
        try {
            var result = await Api.Ticket(id); if(id != Id || lifetime.IsCancellationRequested)return;
            if(ticket is null)hasEarlier = result.HasEarlierMessages;
            ticket = result;
            messages = messages.Concat(result.Messages).DistinctBy(m=>m.Id).OrderBy(m=>m.CreatedAt).ThenBy(m=>m.Id).ToList();
            if(!ticket.AllowedStatuses.Contains(next))next = "";
            if(messages.LastOrDefault() is {} last && last.Id != readId){await Api.ReadTicket(id,last.Id); readId = last.Id;}
            error = null;
        } catch(HttpRequestException e){error=e.Message;} finally{loading=false;}
    }
    private async Task Earlier() {
        if(messages.Count==0)return;busy=true;
        try {var result=await Api.TicketMessages(Id,messages[0].Id);messages=result.Messages.Concat(messages).DistinctBy(m=>m.Id).ToList();hasEarlier=result.HasMore;}
        catch(HttpRequestException e){error=e.Message;}finally{busy=false;}
    }
    private async Task Send() {
        if(busy||string.IsNullOrWhiteSpace(message))return;busy=true;error=null;
        if(pendingMessage==Guid.Empty||pendingText!=message||pendingInternal!=internalNote){pendingMessage=Guid.NewGuid();pendingText=message;pendingInternal=internalNote;}
        try{await Api.Message(Id,new(message,internalNote,pendingMessage));message="";internalNote=false;pendingMessage=Guid.Empty;await Load(true);}
        catch(HttpRequestException e){error=e.Message;}finally{busy=false;}
    }
    private async Task Confirm(bool yes) {
        confirm=false;if(!yes||ticket is null)return;busy=true;error=null;
        try{await Api.ChangeTicket(Id,new(next,ticket.Summary.Version));await Load(true);}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}
    }
    public async ValueTask DisposeAsync(){lifetime.Cancel();if(polling is not null)await polling;lifetime.Dispose();}
}
