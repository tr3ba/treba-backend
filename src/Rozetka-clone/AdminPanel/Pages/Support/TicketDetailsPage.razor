@page "/support/{Id:guid}"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject OperationsApiClient Api
@inject UiTime Time
@inject IJSRuntime Js
<PageTitle>@L["SupportAndReturns"] — Treba Admin</PageTitle>
<a href="/support" class="users-back-link">← @L["SupportAndReturns"]</a>
@if(error is not null){<p class="feedback-error" role="alert">@error <button class="secondary-button" @onclick="()=>Load()">@L["TryAgain"]</button></p>}
@if(loading){<p class="empty-state">@L["Loading"]</p>}
else if(ticket is not null){
    <section class="page-hero"><div><p class="eyebrow">@O["Kind_"+ticket.Summary.Kind]</p><h1>@ticket.Summary.Subject</h1><p>@ticket.Summary.CustomerName · @O["Ticket_"+ticket.Summary.Status]</p></div><button class="secondary-button" disabled="@busy" @onclick="()=>Load()">@L["RefreshData"]</button></section>
    <div class="support-workspace">
        <section class="card-box support-conversation"><header><h2>@O["Conversation"]</h2><span class="operations-caption">@O["AutoRefreshChat"]</span></header>
            @if(hasEarlier){<button class="secondary-button" disabled="@busy" @onclick="Earlier">@O["EarlierMessages"]</button>}
            <ol id="support-message-history" class="support-bubbles" aria-label="@O["Conversation"]" aria-live="polite">
                @foreach(var m in messages){<li @key="m.Id" class="@(m.Internal?"support-note":m.AuthorRole=="Customer"?"support-customer":"support-staff")"><div><strong>@m.AuthorName</strong> <span>@L[m.AuthorRole]</span>@if(m.Internal){<span class="status-badge">@O["InternalNote"]</span>}</div><p class="operations-text">@m.Message</p><time>@Time.Local(m.CreatedAt).ToString("g")</time></li>}
            </ol>
            @if(ticket.Summary.Status!="CLOSED"){
                <form class="support-composer" @onsubmit="Send" @onsubmit:preventDefault>
                    <label class="field-group"><span>@(internalNote?O["InternalNote"]:O["ReplyToCustomer"])</span><textarea class="form-control" rows="4" maxlength="4000" @bind="message" @bind:event="oninput" disabled="@busy"></textarea></label>
                    <div class="support-composer-actions"><label class="operations-check"><input type="checkbox" @bind="internalNote" disabled="@busy"/> @O["InternalNoteHint"]</label><button class="primary-button" disabled="@(busy||string.IsNullOrWhiteSpace(message))">@O["SendMessage"]</button></div>
                </form>
            }
            else{<p class="empty-state">@O["ConversationClosed"]</p>}
        </section>
        <aside class="card-box"><h2>@O["ConversationContext"]</h2><p><a href="@($"/customer-activity/{ticket.Summary.CustomerId}")">@ticket.Summary.CustomerName</a></p>
            @if(ticket.Summary.OrderId.HasValue){<p>@O["OrderNumber"]: <a href="@($"/orders/{ticket.Summary.OrderId}")">@ticket.Summary.OrderNumber</a></p>}
            @if(ticket.Summary.ProductId.HasValue){<p>@O["Product"]: @ticket.Summary.ProductName</p>}
            <hr/><h2>@O["ChangeStatus"]</h2>
            @if(ticket.AllowedStatuses.Count>0){<label class="field-group"><span>@O["NextStatus"]</span><select class="form-control" @bind="next"><option value="">@O["Choose"]</option>@foreach(var state in ticket.AllowedStatuses){<option value="@state">@O["Ticket_"+state]</option>}</select></label>
                @if(ticket.Summary.Kind=="RETURN"){<p class="operations-caption">@O["ReturnReceiptHint"]</p>}
                <button class="primary-button" disabled="@(busy||string.IsNullOrEmpty(next))" @onclick="()=>confirm=true">@L["Save"]</button>}
            else{<p>@O["NoActions"]</p>}
        </aside>
    </div>
}
<ConfirmDialog IsOpen="confirm" Title="@O["ChangeStatus"]" Message="@(ticket?.Summary.Kind=="RETURN"&&ticket.Summary.Status=="APPROVED"&&next=="CLOSED"?O["ConfirmReturnReceived"]:O["ConfirmStatus"])" OnClose="Confirm" />
@code {
    [Parameter] public Guid Id { get; set; }
    private TicketDetails? ticket;
    private List<TicketMessageView> messages = [];
    private bool loading, busy, confirm, internalNote, hasEarlier;
    private string? error;
    private string message = "", next = "", pendingText = "";
    private Guid pendingMessage, loadedId, readId;
    private Guid renderedMessage;
    private bool pendingInternal;
    private readonly CancellationTokenSource lifetime = new();
    private Task? polling;
    protected override async Task OnParametersSetAsync() {
        if (loadedId != Id) { ticket = null; messages.Clear(); message = next = ""; readId = Guid.Empty; loadedId = Id; }
        await Load();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender)polling=Poll();
        if(messages.LastOrDefault() is {} last&&renderedMessage!=last.Id){renderedMessage=last.Id;await Js.InvokeVoidAsync("trebaSupport.latest","support-message-history");}
    }
    private async Task Poll() {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while(await timer.WaitForNextTickAsync(lifetime.Token)) if(!busy&&!confirm) await InvokeAsync(()=>Load(true)); }
        catch(OperationCanceledException) { }
    }
    private async Task Load(bool silent = false) {
        var id = Id; if(!silent)loading = true;
        try {
            var result = await Api.Ticket(id); if(id != Id || lifetime.IsCancellationRequested)return;
            if(ticket is null)hasEarlier = result.HasEarlierMessages;
            ticket = result;
            messages = messages.Concat(result.Messages).DistinctBy(m=>m.Id).OrderBy(m=>m.CreatedAt).ThenBy(m=>m.Id).ToList();
            if(!ticket.AllowedStatuses.Contains(next))next = "";
            if(messages.LastOrDefault() is {} last && last.Id != readId){await Api.ReadTicket(id,last.Id); readId = last.Id;}
            error = null;
        } catch(HttpRequestException e){error=e.Message;} finally{loading=false;}
    }
    private async Task Earlier() {
        if(messages.Count==0)return;busy=true;
        try {var result=await Api.TicketMessages(Id,messages[0].Id);messages=result.Messages.Concat(messages).DistinctBy(m=>m.Id).ToList();hasEarlier=result.HasMore;}
        catch(HttpRequestException e){error=e.Message;}finally{busy=false;}
    }
    private async Task Send() {
        if(busy||string.IsNullOrWhiteSpace(message))return;busy=true;error=null;
        if(pendingMessage==Guid.Empty||pendingText!=message||pendingInternal!=internalNote){pendingMessage=Guid.NewGuid();pendingText=message;pendingInternal=internalNote;}
        try{await Api.Message(Id,new(message,internalNote,pendingMessage));message="";internalNote=false;pendingMessage=Guid.Empty;await Load(true);}
        catch(HttpRequestException e){error=e.Message;}finally{busy=false;}
    }
    private async Task Confirm(bool yes) {
        confirm=false;if(!yes||ticket is null)return;busy=true;error=null;
        try{await Api.ChangeTicket(Id,new(next,ticket.Summary.Version));await Load(true);}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}
    }
    public async ValueTask DisposeAsync(){lifetime.Cancel();if(polling is not null)await polling;lifetime.Dispose();}
}
