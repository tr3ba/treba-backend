@page "/reviews"
@using Contracts.Admin.Reviews
@using System.Globalization
@using System.Text.Json
@inject ReviewsApiClient ReviewsApi
@inject ReviewModerationState Moderation
@inject AuthenticationStateProvider Authentication

<PageTitle>@L["Reviews"] — Treba Admin</PageTitle>

<section class="page-hero workspace-hero">
    <div><p class="eyebrow">@L["TrustAndQuality"]</p><h1>@L["ReviewsManagement"]</h1><p>@L["ReviewQueueDescription"]</p></div>
    <button type="button" class="secondary-button" disabled="@Busy" @onclick="ReloadAsync"><i class="bi bi-arrow-clockwise"></i>@L["RefreshData"]</button>
</section>

@if (_actionFailed) { <p class="feedback-error" role="alert">@L["ReviewActionFailed"]</p> }
@if (_success) { <p class="feedback-success" role="status">@L["ReviewStatusSaved"]</p> }

<section class="card-box review-toolbar">
    <div class="filter-pills" role="group" aria-label="@L["Status"]">
        @foreach (var status in new[] { "PENDING", "PUBLISHED", "REJECTED", "" })
        {
            <button type="button" class="filter-pill @(_status == status ? "active" : "")" disabled="@Busy" @onclick="() => FilterAsync(status)">
                @StatusLabel(status)
                @if (status == "PENDING") { <span class="review-filter-count">@Moderation.PendingCount</span> }
            </button>
        }
    </div>
    <form class="review-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label class="workspace-search"><i class="bi bi-search"></i><input type="search" @bind="_search" placeholder="@L["ReviewSearchPlaceholder"]" aria-label="@L["SearchReviews"]" /></label>
        <button class="secondary-button" type="submit" disabled="@Busy">@L["Search"]</button>
    </form>
</section>

@if (_loading)
{
    <section class="card-box workspace-empty" role="status"><div class="spinner-border text-warning" aria-hidden="true"></div><p>@L["Loading"]</p></section>
}
else if (_loadFailed)
{
    <section class="card-box workspace-empty" role="alert"><i class="bi bi-exclamation-triangle"></i><h2>@L["ReviewsLoadFailed"]</h2><button class="secondary-button" @onclick="ReloadAsync">@L["TryAgain"]</button></section>
}
else if (_result is null || _result.Content.Count == 0)
{
    <section class="card-box workspace-empty" role="status"><span class="workspace-empty-icon"><i class="bi bi-chat-square-text"></i></span><h2>@L["NoReviewsFound"]</h2><p>@L["NoReviewsFoundDescription"]</p></section>
}
else
{
    <p class="review-results-count">@L["ReviewResultsCount", _result.TotalElements]</p>
    <div class="review-queue" aria-busy="@(_busyId is not null)">
        @foreach (var review in _result.Content)
        {
            <article class="card-box admin-review-card" @key="review.Id">
                <header class="admin-review-header">
                    <div><p class="eyebrow">@L["Product"]</p><a class="admin-review-product" href="@(_canEditProducts ? $"/products/{review.ProductId}/edit" : "/products")">@review.ProductName</a></div>
                    <span class="status-badge @StatusClass(review.Status)">@StatusLabel(review.Status)</span>
                </header>
                <div class="admin-review-author"><strong>@review.AuthorName</strong><span>@review.AuthorEmail</span><time datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</time></div>
                <div class="admin-review-rating"><span aria-label="@L["ReviewRating", review.Rating]">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>@if (review.VerifiedPurchase) { <small><i class="bi bi-patch-check"></i>@L["VerifiedPurchase"]</small> }</div>
                <h2>@review.Title</h2><p class="admin-review-comment">@review.Comment</p>
                <footer class="admin-review-actions">
                    @if (review.Status != "REJECTED") { <button type="button" class="secondary-button danger-button" disabled="@Busy" @onclick="() => _reject = review"><i class="bi bi-x-lg"></i>@L["Reject"]</button> }
                    @if (review.Status != "PUBLISHED") { <button type="button" class="primary-button" disabled="@Busy" @onclick="() => PublishAsync(review)"><i class="bi bi-check2"></i>@(_busyId == review.Id ? L["Saving"] : L["PublishReview"])</button> }
                </footer>
            </article>
        }
    </div>
    @if (_result.TotalPages > 1)
    {
        <div class="review-pagination"><button class="secondary-button" disabled="@(Busy || _result.Page <= 1)" @onclick="() => LoadAsync(_result.Page - 1)">@L["Previous"]</button><span>@L["ReviewPage", _result.Page, _result.TotalPages]</span><button class="secondary-button" disabled="@(Busy || _result.Page >= _result.TotalPages)" @onclick="() => LoadAsync(_result.Page + 1)">@L["Next"]</button></div>
    }
}

<ConfirmDialog IsOpen="@(_reject is not null)" Title="@L["Reject"]" Message="@L["RejectReviewConfirm"]" OnClose="ConfirmRejectAsync" />

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? InitialStatus { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? InitialSearch { get; set; }
    private PagedResponse<AdminReviewDto>? _result;
    private string _status = "PENDING", _search = "", _appliedSearch = "";
    private bool _loading = true;
    private bool _loadFailed, _actionFailed, _success;
    private Guid? _busyId;
    private AdminReviewDto? _reject;
    private bool _canEditProducts;
    private bool Busy => _loading || _busyId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _canEditProducts = user.IsInRole("Administrator") || user.IsInRole("Manager");
        _status = InitialStatus?.ToUpperInvariant() is "PUBLISHED" or "REJECTED" ? InitialStatus.ToUpperInvariant() : "PENDING";
        _search = _appliedSearch = InitialSearch ?? "";
        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _loading = true; _loadFailed = false;
        try
        {
            _result = await ReviewsApi.ListAsync(page, _status, _appliedSearch);
            if (_result.Content.Count == 0 && page > 1)
                _result = await ReviewsApi.ListAsync(Math.Max(1, _result.TotalPages), _status, _appliedSearch);
            try { await Moderation.RefreshAsync(); }
            catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException) { }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException) { _loadFailed = true; }
        finally { _loading = false; }
    }

    private Task ReloadAsync() => LoadAsync(_result?.Page ?? 1);
    private Task PublishAsync(AdminReviewDto review) => ModerateAsync(review, "PUBLISHED");
    private Task FilterAsync(string status) { _status = status; _success = false; return LoadAsync(1); }
    private Task SearchAsync() { _appliedSearch = _search.Trim(); _success = false; return LoadAsync(1); }
    private async Task ConfirmRejectAsync(bool confirmed)
    {
        var review = _reject; _reject = null;
        if (confirmed && review is not null) await ModerateAsync(review, "REJECTED");
    }
    private async Task ModerateAsync(AdminReviewDto review, string status)
    {
        if (Busy) return;
        _busyId = review.Id; _actionFailed = false; _success = false;
        try { await ReviewsApi.ModerateAsync(review.Id, status); _success = true; await LoadAsync(_result?.Page ?? 1); }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException) { _actionFailed = true; }
        finally { _busyId = null; }
    }
    private string StatusLabel(string status) => L[status switch { "PENDING" => "PendingReview", "PUBLISHED" => "Published", "REJECTED" => "Rejected", _ => "All" }];
    private static string StatusClass(string status) => status switch { "PUBLISHED" => "badge-active", "REJECTED" => "badge-deleted", _ => "badge-pending" };
}
