@page "/loyalty/new"
@page "/loyalty/{Id:guid}"
@inject OperationsApiClient Api
@inject CatalogApiClient Catalog
@inject NavigationManager Nav
@inject UiTime Time
@using Contracts.Catalog
<PageTitle>@O["PromotionName"] — Treba Admin</PageTitle>
<a href="/loyalty" class="users-back-link">← @L["PromotionsAndLoyalty"]</a>
<section class="page-hero"><div><p class="eyebrow">@L["Growth"]</p><h1>@O[Id.HasValue?"EditPromotion":"NewPromotion"]</h1></div></section>
@if(error is not null){<p class="feedback-error" role="alert">@error</p>}
@if(loading){<p class="empty-state">@L["Loading"]</p>}
else if(ready)
{
    <EditForm Model="model" OnValidSubmit="Save" FormName="promotion-editor"><DataAnnotationsValidator/><ValidationSummary/>
    <section class="card-box"><div class="operations-form-grid">
        <label class="field-group"><span>@O["PromotionName"] *</span><InputText class="form-control" @bind-Value="model.Name" maxlength="255" /></label>
        <label class="field-group"><span>@L["Status"]</span><InputSelect class="form-control" @bind-Value="model.Status">@foreach(var state in OperationsUi.PromotionStatuses){<option value="@state">@O["Promotion_"+state]</option>}</InputSelect></label>
        <label class="field-group"><span>@O["DiscountType"]</span><InputSelect class="form-control" @bind-Value="model.Type"><option value="PERCENTAGE">@O["Percentage"]</option><option value="FIXED_AMOUNT">@O["FixedAmount"]</option></InputSelect></label>
        <label class="field-group"><span>@O["DiscountValue"] *</span><InputNumber class="form-control" @bind-Value="model.DiscountValue" min="0.01" step="0.01" /></label>
        <label class="field-group"><span>@O["StartsLocal"]</span><input type="datetime-local" class="form-control" @bind="start" /></label>
        <label class="field-group"><span>@O["EndsLocal"]</span><input type="datetime-local" class="form-control" @bind="end" /></label>
        <label class="field-group"><span>@O["MinimumOrder"]</span><InputNumber class="form-control" @bind-Value="model.MinimumOrderAmount" min="0" step="0.01" /></label>
        <label class="field-group"><span>@O["MaximumDiscount"]</span><InputNumber class="form-control" @bind-Value="model.MaximumDiscount" min="0.01" step="0.01" /></label>
    </div><label class="field-group"><span>@L["Description"]</span><InputTextArea class="form-control" rows="3" maxlength="4000" @bind-Value="model.Description" /></label><p class="operations-caption">@O["DraftScheduleHint"]</p></section>
    <section class="card-box"><h2>@O["PromotionTargets"]</h2><p class="operations-caption">@O["TargetsHint"]</p><div class="operations-form-grid">
        <label class="field-group"><span>@L["Category"]</span><InputSelect class="form-control" @bind-Value="model.CategoryId"><option value="">@O["All"]</option>@foreach(var c in options?.Categories??[]){<option value="@c.Id">@c.Name</option>}</InputSelect></label>
        <label class="field-group"><span>@L["Brand"]</span><InputSelect class="form-control" @bind-Value="model.BrandId"><option value="">@O["All"]</option>@foreach(var c in options?.Brands??[]){<option value="@c.Id">@c.Name</option>}</InputSelect></label>
        <label class="field-group"><span>@O["Seller"]</span><InputSelect class="form-control" @bind-Value="model.SellerId"><option value="">@O["All"]</option>@foreach(var c in options?.Sellers??[]){<option value="@c.Id">@c.Name</option>}</InputSelect></label>
        <label class="field-group"><span>@L["ProductsNav"]</span><InputSelect class="form-control" @bind-Value="model.ProductId"><option value="">@O["All"]</option>@foreach(var p in products){<option value="@p.Id">@p.Name</option>}</InputSelect></label>
    </div><div class="operations-toolbar"><label class="field-group"><span>@O["FindProduct"]</span><input class="form-control" @bind="productSearch" /></label><button type="button" class="secondary-button" disabled="@busy" @onclick="FindProducts">@L["Search"]</button></div></section>
    <section class="card-box"><h2>@O["CouponCodes"]</h2><p class="operations-caption">@O["CouponLimitsHint"]</p>
    @foreach(var c in model.Coupons){<div class="operations-coupon-row" @key="c"><label class="field-group"><span>@O["CouponCode"]</span><InputText class="form-control" @bind-Value="c.Code" disabled="@c.Id.HasValue" maxlength="100" /></label><label class="field-group"><span>@O["GlobalLimit"]</span><InputNumber class="form-control" @bind-Value="c.UsageLimit" min="0" /></label><label class="field-group"><span>@O["PerUserLimit"]</span><InputNumber class="form-control" @bind-Value="c.UsageLimitPerUser" min="0" /></label><label class="operations-check"><InputCheckbox @bind-Value="c.Active" /> @O["Enabled"]</label><button class="secondary-button" type="button" disabled="@(busy||model.Coupons.Count==1)" @onclick="()=>model.Coupons.Remove(c)">@O["Remove"]</button></div>}
    <button type="button" class="secondary-button" disabled="@(busy||model.Coupons.Count>=30)" @onclick="()=>model.Coupons.Add(new())">@O["AddCoupon"]</button></section>
    <div class="operations-toolbar"><button type="submit" class="primary-button" disabled="@busy">@L["Save"]</button><a href="/loyalty" class="secondary-button">@L["Cancel"]</a></div>
    </EditForm>
}
@code{
    [Parameter]public Guid? Id{get;set;}private PromotionInput model=new();private DateTime start,end;private bool loading,busy,ready;private string? error;private string productSearch="";private CatalogFilterOptionsDto? options;private List<CatalogProductDto> products=[];
    protected override async Task OnParametersSetAsync(){loading=true;ready=false;error=null;try{options=await Catalog.FilterOptions();if(Id.HasValue){var p=await Api.Promotion(Id.Value);model=new(){Name=p.Name,Description=p.Description,Type=p.Type,Status=p.Status,DiscountValue=p.DiscountValue,MaximumDiscount=p.MaximumDiscount,MinimumOrderAmount=p.MinimumOrderAmount,ProductId=p.ProductId,CategoryId=p.CategoryId,BrandId=p.BrandId,SellerId=p.SellerId,StartAt=p.StartAt,EndAt=p.EndAt,ExpectedVersion=p.Version,Coupons=p.Coupons.Select(c=>new CouponInput{Id=c.Id,Code=c.Code,UsageLimit=c.UsageLimit,UsageLimitPerUser=c.UsageLimitPerUser,Active=c.Active}).ToList()};if(p.ProductId.HasValue)products=[await Catalog.GetProduct(p.ProductId.Value)];}else{model=new();products=[];}start=Time.Local(model.StartAt).DateTime;end=Time.Local(model.EndAt).DateTime;ready=true;}catch(HttpRequestException e){error=e.Message;}finally{loading=false;}}
    private async Task FindProducts(){busy=true;error=null;try{var found=await Catalog.List(search:productSearch);var selected=products.FirstOrDefault(p=>p.Id==model.ProductId);products=found.Content.ToList();if(selected is not null&&products.All(p=>p.Id!=selected.Id))products.Insert(0,selected);}catch(HttpRequestException e){error=e.Message;}finally{busy=false;}}
    private async Task Save(){busy=true;error=null;try{model.StartAt=Time.Utc(start);model.EndAt=Time.Utc(end);var saved=await Api.SavePromotion(Id,model);Nav.NavigateTo("/loyalty");}catch(Exception e)when(e is HttpRequestException or ArgumentException){error=e.Message;}finally{busy=false;}}
}
