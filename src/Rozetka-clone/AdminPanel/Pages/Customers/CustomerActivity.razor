@page "/customer-activity"
@inject OperationsApiClient Api
@inject UiTime Time

<PageTitle>@L["CustomerActivity"] — Treba Admin</PageTitle>

<section class="page-hero">
    <div><p class="eyebrow">@L["CustomerInsights"]</p><h1>@L["CustomerActivity"]</h1></div>
</section>

<section class="card-box"><form class="operations-toolbar" @onsubmit="Search" @onsubmit:preventDefault><label class="field-group"><span>@L["Search"]</span><input class="form-control" @bind="search" placeholder="@O["CustomerSearch"]" /></label><button class="primary-button" disabled="@loading">@L["Search"]</button></form>
@if(error is not null){<p class="feedback-error" role="alert">@error <button class="secondary-button" @onclick="()=>Load(page)">@L["TryAgain"]</button></p>}
@if(loading){<p class="empty-state">@L["Loading"]</p>}else if(result is not null){<div class="table-wrap"><table class="custom-table"><thead><tr><th>@O["Customer"]</th><th>@L["Orders"]</th><th>@O["OrderedAmount"]</th><th>@L["Reviews"]</th><th>@O["LastOrder"]</th></tr></thead><tbody>@foreach(var c in result.Content){<tr><td><a href="@($"/customer-activity/{c.Id}")">@c.Name</a><small class="operations-muted">@c.Email</small></td><td>@c.Orders</td><td>@c.OrderedAmount.ToString("N2") ₴</td><td>@c.Reviews</td><td>@(c.LastOrderAt.HasValue?Time.Local(c.LastOrderAt.Value).ToString("g"):"—")</td></tr>}</tbody></table></div>@if(result.Content.Count==0){<p class="empty-state">@O["NoResults"]</p>}<PaginationControl CurrentPage="result.Page" TotalPages="result.TotalPages" OnPageChanged="Load" />}</section>
@code{private PagedResponse<CustomerRow>? result;private string search="";private string? error;private bool loading;private int page=1;protected override Task OnInitializedAsync()=>Load(1);private Task Search()=>Load(1);private async Task Load(int p){page=p;loading=true;error=null;try{result=await Api.Customers(p,search);}catch(HttpRequestException e){error=e.Message;result=null;}finally{loading=false;}}}
