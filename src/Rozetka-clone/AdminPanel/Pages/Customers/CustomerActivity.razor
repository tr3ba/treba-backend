@page "/customer-activity"

<PageTitle>@L["CustomerActivity"] — Treba Admin</PageTitle>
<section class="page-hero"><div><p class="eyebrow">@L["CustomerInsights"]</p><h1>@L["CustomerActivity"]</h1></div><button class="primary-button" type="button"><i class="bi bi-download"></i>@L["Export"]</button></section>
<section class="activity-funnel"><div><span class="activity-icon blue"><i class="bi bi-eye"></i></span><small>@L["ViewedProducts"]</small><strong>184 260</strong><em>100%</em></div><i class="bi bi-chevron-right"></i><div><span class="activity-icon purple"><i class="bi bi-arrow-left-right"></i></span><small>@L["Comparisons"]</small><strong>42 681</strong><em>23.2%</em></div><i class="bi bi-chevron-right"></i><div><span class="activity-icon pink"><i class="bi bi-heart"></i></span><small>@L["Wishlists"]</small><strong>31 940</strong><em>17.3%</em></div><i class="bi bi-chevron-right"></i><div><span class="activity-icon orange"><i class="bi bi-cart3"></i></span><small>@L["ActiveCarts"]</small><strong>18 472</strong><em>10.0%</em></div></section>
<section class="activity-grid"><article class="card-box activity-chart"><div class="card-box-header"><div><h2 class="card-box-title">@L["ShoppingIntent"]</h2><p>@L["ShoppingIntentDesc"]</p></div><select aria-label="@L["Period"]"><option>@L["Last30Days"]</option></select></div><div class="bar-chart">@foreach(var bar in Bars){<div><i style="height:@(bar)%"></i></div>}</div><div class="chart-labels"><span>01.08</span><span>08.08</span><span>15.08</span><span>22.08</span><span>30.08</span></div></article><article class="card-box parcel-summary"><div class="card-box-header"><h2 class="card-box-title">@L["Parcels"]</h2><a href="/orders" class="btn-link-action">@L["ViewAll"]</a></div><div class="parcel-stat"><span class="activity-icon blue"><i class="bi bi-box-seam"></i></span><div><strong>2 841</strong><small>@L["InTransit"]</small></div></div><div class="parcel-stat"><span class="activity-icon green"><i class="bi bi-check2-circle"></i></span><div><strong>8 204</strong><small>@L["Delivered"]</small></div></div><div class="parcel-stat"><span class="activity-icon orange"><i class="bi bi-clock-history"></i></span><div><strong>314</strong><small>@L["Delayed"]</small></div></div></article></section>
<section class="card-box activity-segments"><div class="card-box-header"><h2 class="card-box-title">@L["CustomerSegments"]</h2><button class="secondary-button" type="button">@L["CreateSegment"]</button></div><div class="segment-grid"><article><span class="segment-color blue"></span><div><strong>@L["HighIntent"]</strong><p>@L["HighIntentDesc"]</p></div><b>4 820</b></article><article><span class="segment-color orange"></span><div><strong>@L["AbandonedCarts"]</strong><p>@L["AbandonedCartsDesc"]</p></div><b>7 143</b></article><article><span class="segment-color purple"></span><div><strong>@L["LoyalCustomers"]</strong><p>@L["LoyalCustomersDesc"]</p></div><b>2 946</b></article></div></section>
@code { private static readonly int[] Bars=[36,48,43,61,55,74,69,82,65,88,79,94,86,72,91]; }
