@page "/settings/audit"
@using Contracts.Admin.Settings
@inject AdminPanel.Services.Implementations.SettingsApiClient Api
@inject AdminPanel.Services.Implementations.UiTime Time

<PageTitle>@L["AuditLog"] — Treba Admin</PageTitle>
<a class="users-back-link" href="/settings"><i class="bi bi-arrow-left"></i>@L["Settings"]</a>
<section class="page-hero"><div><p class="eyebrow">@L["Settings"]</p><h1>@L["AuditLog"]</h1><p>@L["AuditLogDescription"]</p></div></section>
@if (_error is not null) { <p class="feedback-error" role="alert">@_error</p> }
<section class="card-box">
    <form class="store-toolbar audit-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label class="workspace-search"><i class="bi bi-search"></i><input @bind="_search" placeholder="@L["AuditSearch"]" aria-label="@L["AuditSearch"]" /></label>
        <label><span>@L["AuditEntity"]</span><select class="form-control" @bind="_entity"><option value="">@L["All"]</option>@foreach(var entity in Entities) { <option value="@entity">@L["AuditEntity" + entity]</option> }</select></label>
        <label><span>@L["AuditAction"]</span><select class="form-control" @bind="_action"><option value="">@L["All"]</option>@foreach(var action in Actions) { <option value="@action">@L["AuditAction" + action]</option> }</select></label>
        <label><span>@L["DateFrom"]</span><InputDate class="form-control" @bind-Value="_from" /></label><label><span>@L["DateTo"]</span><InputDate class="form-control" @bind-Value="_to" /></label>
        <button class="secondary-button" disabled="@_loading">@L["Search"]</button>
    </form>
    @if (_loading) { <p class="empty-state">@L["Loading"]</p> }
    else if (_result is not null)
    {
        @if (_result.Content.Count == 0) { <p class="empty-state">@L["AuditEmpty"]</p> }
        @foreach(var log in _result.Content)
        {
            <article class="audit-entry"><div class="audit-entry-heading"><div><strong>@log.ActorName</strong><span>@L["Role" + log.ActorRole]</span></div><time>@Time.Local(log.OccurredAt).ToString("dd.MM.yyyy HH:mm:ss")</time></div><p><span class="status-badge badge-pending">@L["AuditAction" + log.Action]</span> @L["AuditEntity" + log.EntityType] · <strong>@log.EntityName</strong></p>
                <details><summary>@L["AuditChanges"] (@log.Changes.Count)</summary><div class="table-wrap"><table class="custom-table"><thead><tr><th>@L["AuditField"]</th><th>@L["AuditBefore"]</th><th>@L["AuditAfter"]</th></tr></thead><tbody>@foreach(var change in log.Changes) { <tr><td>@L["AuditField" + change.Field]</td><td class="audit-value">@(change.Before ?? "—")</td><td class="audit-value">@(change.After ?? "—")</td></tr> }</tbody></table></div></details>
            </article>
        }
        @if (_result.TotalPages > 1) { <PaginationControl CurrentPage="_result.Page" TotalPages="_result.TotalPages" OnPageChanged="LoadAsync" /> }
    }
</section>

@code {
    private static readonly string[] Entities = ["User", "Product", "ProductVariant", "ProductImage", "ProductAttributeValue", "Category", "Brand", "Seller", "Store", "Review"];
    private static readonly string[] Actions = ["Create", "Update", "Delete", "Moderation"];
    private Contracts.Common.PagedResponse<AuditLogDto>? _result;
    private string _search = "", _entity = "", _action = "";
    private DateOnly? _from, _to;
    private bool _loading = true;
    private string? _error;
    protected override Task OnInitializedAsync() => LoadAsync(1);
    private Task SearchAsync() => LoadAsync(1);
    private async Task LoadAsync(int page)
    {
        _loading = true; _error = null;
        try { _result = await Api.Audit(page, _search, _entity, _action, _from, _to); }
        catch (HttpRequestException e) { _error = e.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable ? L["SettingsDatabaseUpdateRequired"] : e.Message; }
        finally { _loading = false; }
    }
}
