@page "/settings/features"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@using Contracts.Admin.Settings
@inject SettingsApiClient Api
@inject UiTime Time

<PageTitle>@L["Features"] — TREBA</PageTitle>
<a class="users-back-link" href="/settings"><i class="bi bi-arrow-left"></i>@L["Settings"]</a>
<section class="page-hero"><div class="page-title-with-icon"><span class="page-title-icon"><i class="bi bi-toggles2" aria-hidden="true"></i></span><div><p class="eyebrow">@L["Settings"]</p><h1>@L["Features"]</h1><p>@L["FeaturesDescription"]</p></div></div><button class="secondary-button" disabled="@_busy" @onclick="Load"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>@L["RefreshData"]</button></section>
@if (_error is not null) { <p class="feedback-error" role="alert">@_error</p> }
@if (_saved) { <p class="feature-saved" role="status"><i class="bi bi-check2-circle" aria-hidden="true"></i>@L["FeatureSaved"]</p> }
@if (_loading) { <p class="empty-state" role="status">@L["Loading"]</p> }
else
{
    @foreach (var flag in _features)
    {
        <article class="card-box feature-card">
            <div class="feature-card-heading"><span class="feature-card-icon"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span><div><h2>@L["FeatureChatDeletion"]</h2><span class="feature-state @(flag.Enabled ? "enabled" : "")">@L[flag.Enabled ? "FeatureEnabled" : "FeatureDisabled"]</span></div>
                <button type="button" role="switch" class="feature-switch" aria-label="@L["FeatureChatDeletion"]" aria-checked="@flag.Enabled.ToString().ToLowerInvariant()" disabled="@_busy" @onclick="() => Toggle(flag)"><span></span></button>
            </div>
            <p>@L["FeatureChatDeletionDescription"]</p>
            <div class="feature-notice"><i class="bi bi-info-circle" aria-hidden="true"></i><span>@L["FeatureChatDeletionHint"]</span></div>
            @if (flag.UpdatedAt is { } updated) { <small class="feature-updated">@L["FeatureUpdated"] @Time.Local(updated).ToString("g")</small> }
        </article>
    }
}

@code {
    private IReadOnlyList<FeatureFlagDto> _features = [];
    private bool _loading = true, _busy, _saved;
    private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _loading = true; _error = null; _saved = false;
        try { _features = await Api.Features(); }
        catch (Exception e) when (e is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) { _error = e.Message; }
        finally { _loading = false; }
    }
    private async Task Toggle(FeatureFlagDto flag)
    {
        if (_busy) return;
        _busy = true; _saved = false; _error = null;
        try
        {
            var saved = await Api.SetFeature(flag.Key, new(!flag.Enabled, flag.Version));
            _features = _features.Select(x => x.Key == saved.Key ? saved : x).ToList(); _saved = true;
        }
        catch (Exception e) when (e is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) { _error = e.Message; }
        finally { _busy = false; }
    }
}
