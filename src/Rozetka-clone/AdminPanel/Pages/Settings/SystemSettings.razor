@page "/settings"

<PageTitle>@L["Settings"] — Treba Admin</PageTitle>

<section class="page-hero">
    <div><p class="eyebrow">@L["System"]</p><h1>@L["Settings"]</h1></div>
</section>

<p class="settings-intro">@L["SettingsDescription"]</p>
<div class="settings-grid">
    <a class="card-box settings-card" href="/settings/features"><i class="bi bi-toggles2"></i><h2>@L["Features"]</h2><p>@L["FeaturesDescription"]</p><span>@L["Open"] <i class="bi bi-arrow-right"></i></span></a>
    <a class="card-box settings-card" href="/settings/telegram"><i class="bi bi-telegram"></i><h2>Telegram · Treba</h2><p>@L["TelegramSettingsDescription"]</p><span>@L["Open"] <i class="bi bi-arrow-right"></i></span></a>
    <a class="card-box settings-card" href="/settings/staff"><i class="bi bi-person-gear"></i><h2>@L["StaffAndRoles"]</h2><p>@L["StaffAndRolesDescription"]</p><span>@L["Open"] <i class="bi bi-arrow-right"></i></span></a>
    <a class="card-box settings-card" href="/settings/audit"><i class="bi bi-clock-history"></i><h2>@L["AuditLog"]</h2><p>@L["AuditLogDescription"]</p><span>@L["Open"] <i class="bi bi-arrow-right"></i></span></a>
</div>
