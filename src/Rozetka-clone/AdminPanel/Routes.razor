@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @if (routeData.PageType == typeof(AdminPanel.Pages.Auth.Login))
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.AuthLayout)" />
            }
            else
            {
                <AuthorizeView Roles="@AdminAccess.StaffRoles" Context="access">
                    <Authorized>
                        @if (AdminAccess.CanAccess(access.User.FindFirst(ClaimTypes.Role)?.Value, new Uri(Navigation.Uri).AbsolutePath))
                        {
                            <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
                        }
                        else
                        {
                            <LayoutView Layout="@typeof(Layout.MainLayout)">
                                <section class="card-box workspace-empty" role="alert">
                                    <span class="workspace-empty-icon"><i class="bi bi-shield-lock"></i></span>
                                    <h1>@L["AccessDenied"]</h1>
                                    <a class="secondary-button" href="/">@L["Dashboard"]</a>
                                </section>
                            </LayoutView>
                        }
                    </Authorized>
                    <NotAuthorized><LayoutView Layout="@typeof(Layout.AuthLayout)"><AdminPanel.Pages.Auth.Login /></LayoutView></NotAuthorized>
                    <Authorizing><p role="status">@L["CheckingAccess"]</p></Authorizing>
                </AuthorizeView>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound><LayoutView Layout="@typeof(Layout.AuthLayout)"><h1>@L["PageNotFound"]</h1><a href="/">@L["Home"]</a></LayoutView></NotFound>
    </Router>
</CascadingAuthenticationState>
