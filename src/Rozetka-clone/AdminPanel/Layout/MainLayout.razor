@inherits LayoutComponentBase
@implements IDisposable
@using System.Globalization
@using System.Security.Claims
@using Contracts.Authentication
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject JwtAuthenticationStateProvider Auth
@inject TokenStorageService Tokens
@inject HttpClient Http
@inject CurrentUserState CurrentUser

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnPath = Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);
}

<div class="page">
    <input class="nav-toggle" id="admin-nav-toggle" type="checkbox" />
    <aside class="sidebar"><NavMenu /></aside>
    <main>
        <header class="top-header">
            <label class="mobile-menu-button" for="admin-nav-toggle" aria-label="@L["OpenMenu"]"><i class="bi bi-list"></i></label>
            <div class="header-actions">
                <div class="lang-selector" aria-label="@L["Language"]">
                    <a class="lang-btn @(currentCulture == "uk" ? "active" : "")" data-enhance-nav="false" href="/culture/set?culture=uk&redirectUri=@returnPath">UA</a>
                    <a class="lang-btn @(currentCulture == "en" ? "active" : "")" data-enhance-nav="false" href="/culture/set?culture=en&redirectUri=@returnPath">EN</a>
                    <a class="lang-btn @(currentCulture == "ru" ? "active" : "")" data-enhance-nav="false" href="/culture/set?culture=ru&redirectUri=@returnPath">RU</a>
                </div>
                <div class="profile-menu-container">
                    <button class="user-profile-badge" type="button" @onclick="ToggleProfileMenu" aria-expanded="@_menuOpen" aria-haspopup="menu">
                        @if (!string.IsNullOrWhiteSpace(AvatarUrl))
                        {
                            <img class="avatar avatar-image" src="@AvatarUrl" alt="" />
                        }
                        else
                        {
                            <span class="avatar" aria-hidden="true">@AvatarInitial</span>
                        }
                        <span class="user-info-text">
                            <span class="user-name">@DisplayName</span>
                            <span class="user-role">@RoleLabel</span>
                        </span>
                        <i class="bi bi-chevron-down user-chevron @(_menuOpen ? "open" : "")" aria-hidden="true"></i>
                    </button>
                    @if (_menuOpen)
                    {
                        <div class="profile-dropdown" role="menu">
                            <div class="profile-dropdown-summary"><strong>@DisplayName</strong><span>@Email</span></div>
                            <a class="profile-dropdown-item" href="/profile" role="menuitem" @onclick="CloseProfileMenu"><i class="bi bi-person"></i><span>@L["Profile"]</span></a>
                            <button class="profile-dropdown-item profile-dropdown-logout" type="button" role="menuitem" @onclick="LogoutAsync" disabled="@_loggingOut"><i class="bi bi-box-arrow-right"></i><span>@(_loggingOut ? L["SigningOut"] : L["SignOut"])</span></button>
                        </div>
                    }
                </div>
            </div>
        </header>
        <article class="content-body">@Body</article>
    </main>
</div>

@code {
    private bool _menuOpen;
    private bool _loggingOut;
    private string _claimEmail = string.Empty;
    private string _claimFirstName = string.Empty;
    private string _claimLastName = string.Empty;
    private string _role = string.Empty;

    private string Email => CurrentUser.User?.Email ?? _claimEmail;
    private string? AvatarUrl => CurrentUser.AvatarDataUrl;
    private string DisplayName
    {
        get
        {
            var firstName = CurrentUser.User?.FirstName ?? _claimFirstName;
            var lastName = CurrentUser.User?.LastName ?? _claimLastName;
            var fullName = $"{firstName} {lastName}".Trim();
            if (!string.IsNullOrWhiteSpace(fullName)) return fullName;
            if (!string.IsNullOrWhiteSpace(Email)) return Email.Split('@')[0];
            return L["User"];
        }
    }
    private string AvatarInitial => DisplayName.Trim()[..1].ToUpper(CultureInfo.CurrentCulture);
    private string RoleLabel => string.IsNullOrWhiteSpace(_role) ? L["User"] : L[_role];

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.Changed += HandleCurrentUserChanged;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        _claimEmail = principal.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
        _claimFirstName = principal.FindFirst("firstName")?.Value ?? string.Empty;
        _claimLastName = principal.FindFirst("lastName")?.Value ?? string.Empty;
        _role = principal.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

        try { await CurrentUser.LoadAsync(); }
        catch (HttpRequestException) { }
    }

    private void ToggleProfileMenu() => _menuOpen = !_menuOpen;
    private void CloseProfileMenu() => _menuOpen = false;

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        try
        {
            var refreshToken = await Tokens.GetRefreshTokenAsync();
            if (!string.IsNullOrWhiteSpace(refreshToken))
            {
                try { await Http.PostAsJsonAsync("api/auth/logout", new RefreshTokenRequest(refreshToken)); }
                catch (HttpRequestException) { }
            }
        }
        finally
        {
            CurrentUser.Clear();
            await Auth.NotifyUserLogoutAsync();
            Navigation.NavigateTo("/auth/login", forceLoad: true);
        }
    }

    private void HandleCurrentUserChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => CurrentUser.Changed -= HandleCurrentUserChanged;
}
