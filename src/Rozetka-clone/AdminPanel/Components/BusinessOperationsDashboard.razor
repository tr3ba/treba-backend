@inject OperationsApiClient Api
@inject AuthenticationStateProvider Authentication
@if(allowed){<section class="operations-dashboard"><header class="operations-heading"><div><p class="eyebrow">@L["Operations"]</p><h2>@O["BusinessOverview"]</h2><p>@O["MetricsHint"]</p></div><label class="field-group"><span>@O["Period"]</span><select class="form-control" @bind="days" @bind:after="Load" disabled="@loading"><option value="7">@L["PeriodDays",7]</option><option value="30">@L["PeriodDays",30]</option><option value="90">@L["PeriodDays",90]</option></select></label><button class="secondary-button" disabled="@loading" @onclick="Load">@L["RefreshData"]</button></header>
@if(failed){<p class="feedback-error" role="alert">@O["MetricsFailed"] <button class="secondary-button" @onclick="Load">@L["TryAgain"]</button></p>}
else if(loading||data is null){<p class="empty-state">@L["Loading"]</p>}
else{<div class="operations-metrics"><a class="card-box" href="/orders"><span>@O["NewOrders"]</span><strong class="operations-number">@data.NewOrders</strong></a><a class="card-box" href="/orders?status=CANCELLED"><span>@O["CancelledOrders"]</span><strong class="operations-number">@data.CancelledOrders</strong></a><article class="card-box"><span>@O["OrderedAmount"]</span><strong class="operations-number">@data.OrderedAmount.ToString("N2") ₴</strong></article><a class="card-box" href="/support?view=open"><span>@O["OpenTickets"]</span><strong class="operations-number">@data.OpenTickets</strong></a><a class="card-box" href="/support?view=overdue"><span>@O["OverdueTickets"]</span><strong class="operations-number">@data.OverdueTickets</strong></a><a class="card-box" href="@("/products?stock=out&status=ACTIVE")"><span>@O["OutOfStock"]</span><strong class="operations-number">@data.OutOfStockProducts</strong></a><a class="card-box" href="/moderation?waitingHours=24"><span>@O["OverdueModeration"]</span><strong class="operations-number">@data.OverdueModeration</strong></a></div>}
</section>}
@code{private bool allowed,loading,failed;private int days=30;private OperationsMetrics? data;protected override async Task OnInitializedAsync(){var user=(await Authentication.GetAuthenticationStateAsync()).User;allowed=user.IsInRole("Administrator")||user.IsInRole("Manager");if(allowed)await Load();}private async Task Load(){loading=true;failed=false;try{data=await Api.Metrics(days);}catch(HttpRequestException){failed=true;}finally{loading=false;}}}
