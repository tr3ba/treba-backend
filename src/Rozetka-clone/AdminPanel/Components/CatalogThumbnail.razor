@inject CatalogApiClient Media
<span class="catalog-thumbnail @CssClass">
    @if (!string.IsNullOrWhiteSpace(ImageUrl) && !_failed)
    {
        <img @key="ImageUrl" src="@Media.ResolveImageUrl(ImageUrl)" alt="" loading="lazy" decoding="async" @onerror="() => _failed = true" />
    }
    else
    {
        <i class="bi bi-image" aria-hidden="true"></i>
    }
</span>
@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? CssClass { get; set; }
    private string? _previous;
    private bool _failed;
    protected override void OnParametersSet()
    {
        if (_previous != ImageUrl) { _previous = ImageUrl; _failed = false; }
    }
}
