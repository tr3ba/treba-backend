@using Contracts.Catalog
@inject CatalogApiClient Api
@inject UiTime Time

<section class="product-moderation-history">
    @if(Collapsed){<button type="button" class="btn-link-action" aria-expanded="@_open" @onclick="Toggle">@L["ModerationHistory"] <i class="bi @(_open ? "bi-chevron-up" : "bi-chevron-down")"></i></button>}
    else {<h3>@L["ModerationHistory"]</h3>}
    @if(_open)
    {
        @if(_error is not null){<p class="feedback-error" role="alert">@_error</p>}
        else if(_items is null){<p role="status">@L["Loading"]</p>}
        else if(_items.Count==0){<p class="muted-text">@L["ModerationHistoryEmpty"]</p>}
        else
        {
            <ol class="moderation-timeline">
            @foreach(var item in _items){<li><div><strong>@L["Decision"+item.Decision]</strong><time>@Time.Local(item.OccurredAt).ToString("dd.MM.yyyy HH:mm")</time></div><small>@item.ActorName</small>@if(item.Reason is not null){<p>@item.Reason</p>}</li>}
            </ol><small class="muted-text">@L["ModerationHistoryLimit"]</small>
        }
    }
</section>
@code {
    [Parameter]public Guid ProductId{get;set;}
    [Parameter]public bool Collapsed{get;set;}=true;
    private Guid _loaded;
    private bool _open;
    private List<ProductModerationDto>? _items;
    private string? _error;
    protected override async Task OnParametersSetAsync(){if(_loaded!=ProductId){_loaded=ProductId;_items=null;_error=null;_open=!Collapsed;if(_open)await Load();}}
    private async Task Toggle(){_open=!_open;if(_open&&_items is null)await Load();}
    private async Task Load(){try{_items=await Api.ModerationHistory(ProductId);}catch(HttpRequestException ex){_error=ex.Message;}}
}
