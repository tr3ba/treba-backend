@using Contracts.Admin.Dashboard
@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@inject DashboardApiClient DashboardApi
@inject AuthenticationStateProvider Authentication
@inject ReviewModerationState ReviewModeration

@if (_role is "Administrator" or "Manager" or "Moderator")
{
    <section class="operations-dashboard">
        <header class="operations-heading">
            <div><p class="eyebrow">@L["Operations"]</p><h2>@L["MarketplaceOverview"]</h2><p>@L["WorkspaceCountsDescription"]</p></div>
            <div class="operations-controls">
                <label><span>@L["ActivityPeriod"]</span><select class="form-control" @bind="_days" @bind:after="LoadAsync" disabled="@_loading"><option value="7">@L["PeriodDays", 7]</option><option value="30">@L["PeriodDays", 30]</option><option value="90">@L["PeriodDays", 90]</option></select></label>
                <button class="secondary-button" disabled="@_loading" @onclick="LoadAsync" aria-label="@L["RefreshData"]"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </header>
        @if (_failed)
        {
            <div class="card-box workspace-empty" role="alert"><h3>@L["DashboardLoadFailed"]</h3><button class="secondary-button" @onclick="LoadAsync">@L["TryAgain"]</button></div>
        }
        else if (_loading || _data is null)
        {
            <div class="card-box workspace-empty" role="status"><div class="spinner-border text-warning" aria-hidden="true"></div><p>@L["Loading"]</p></div>
        }
        else
        {
            <div class="operations-metrics">
                @if (_data.PendingSellers.HasValue)
                {
                    <a class="card-box operation-metric" href="/sellers?status=0"><span class="stat-icon icon-amber"><i class="bi bi-shop"></i></span><div><span>@L["SellerApplications"]</span><strong>@_data.PendingSellers</strong><small>@L["ActiveSellersCount", _data.ActiveSellers ?? 0]</small></div><i class="bi bi-arrow-up-right"></i></a>
                }
                <a class="card-box operation-metric" href="/reviews?status=PENDING"><span class="stat-icon icon-orange"><i class="bi bi-chat-square-text"></i></span><div><span>@L["ReviewsAwaitingModeration"]</span><strong>@_data.PendingReviews</strong><small>@L["PublishedReviewsCount", _data.PublishedReviews]</small></div><i class="bi bi-arrow-up-right"></i></a>
                @if (_data.NewUsers.HasValue)
                {
                    <a class="card-box operation-metric" href="/users"><span class="stat-icon icon-blue"><i class="bi bi-person-plus"></i></span><div><span>@L["NewUsers"]</span><strong>@_data.NewUsers</strong><small>@L["InLastDays", _data.Days]</small></div><i class="bi bi-arrow-up-right"></i></a>
                    <a class="card-box operation-metric" href="/users"><span class="stat-icon icon-green"><i class="bi bi-people"></i></span><div><span>@L["TotalUsersLabel"]</span><strong>@_data.TotalUsers</strong><small>@L["ExcludingDeletedUsers"]</small></div><i class="bi bi-arrow-up-right"></i></a>
                }
            </div>
            <section class="card-box activity-panel">
                <div class="card-box-header"><div><h2 class="card-box-title">@L["LatestWorkspaceChanges"]</h2><p>@L["LatestWorkspaceChangesDescription"]</p></div><span>@L["InLastDays", _data.Days]</span></div>
                @if (_data.RecentActivity.Count == 0) { <p class="workspace-empty">@L["NoRecentActivity"]</p> }
                else
                {
                    <ul class="workspace-activity-list">
                        @foreach (var item in _data.RecentActivity)
                        {
                            <li><span class="activity-kind-icon"><i class="bi @ActivityIcon(item.Kind)"></i></span><div><a href="@ActivityLink(item)">@item.Name</a><small>@ActivityLabel(item)</small></div><time datetime="@item.OccurredAt.ToString("O")">@item.OccurredAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</time></li>
                        }
                    </ul>
                }
            </section>
        }
    </section>
}

@code {
    private string? _role;
    private AdminDashboardDto? _data;
    private int _days = 30;
    private bool _loading, _failed;

    protected override async Task OnInitializedAsync()
    {
        _role = (await Authentication.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.Role)?.Value;
        if (_role is "Administrator" or "Manager" or "Moderator") await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _failed = false;
        try { _data = await DashboardApi.GetAsync(_days); ReviewModeration.SetPending(_data.PendingReviews); }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException) { _failed = true; }
        finally { _loading = false; }
    }

    private static string ActivityIcon(string kind) => kind switch { "seller" => "bi-shop", "review" => "bi-chat-square-text", "user" => "bi-person-plus", _ => "bi-box-seam" };
    private string ActivityLink(AdminActivityDto item) => item.Kind switch
    {
        "seller" => $"/sellers/review/{item.EntityId}",
        "review" => $"/reviews?status={item.Status}&search={Uri.EscapeDataString(item.Name)}",
        "user" => $"/users/{item.EntityId}",
        _ => _role is "Administrator" or "Manager" ? $"/products/{item.EntityId}/edit" : "/products"
    };
    private string ActivityLabel(AdminActivityDto item)
    {
        if (item.Kind == "user") return L["NewUserRegistered"];
        var group = item.Kind switch { "seller" => "Sellers", "review" => "Reviews", _ => "ProductsNav" };
        var status = item.Status switch
        {
            "PENDING" => "PendingReview", "ACTIVE" => item.Kind == "seller" ? "Verified" : "Published",
            "SUSPENDED" => "Suspended", "PUBLISHED" => "Published", "REJECTED" => "Rejected",
            "DRAFT" => "Drafts", "ARCHIVED" => "ArchivedStatus", _ => "InModeration"
        };
        return $"{L[group]} · {L[status]}";
    }
}
