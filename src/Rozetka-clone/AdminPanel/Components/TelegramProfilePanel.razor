@using Contracts.Telegram
@implements IAsyncDisposable
@inject TelegramApiClient Telegram
@inject AuthenticationStateProvider Authentication

@if (eligible)
{
    <section class="card-box telegram-profile-panel">
        <div class="card-box-header"><h2 class="card-box-title"><i class="bi bi-telegram"></i> Telegram</h2></div>
        <p>@L["TelegramProfileDescription"]</p>
        @if (error is not null) { <p class="feedback-error" role="alert">@error</p> }
        @if (status is { Configured: false }) { <p class="empty-card-text">@L["TelegramNotConfigured"]</p> }
        else if (status is { Linked: true })
        {
            <p class="feedback-success"><i class="bi bi-check-circle"></i> @L["TelegramLinked"] @(status.Username is { } username ? "@" + username : status.TelegramUserId?.ToString())</p>
            <button class="secondary-button" disabled="@busy" @onclick="() => confirmUnlink = true">@L["TelegramUnlink"]</button>
        }
        else if (status?.PendingId is { } pending)
        {
            <p>@L["TelegramConfirmIdentity"] <strong>@status.PendingTelegramName @(status.PendingUsername is { } pendingName ? "@" + pendingName : "")</strong></p>
            <button class="primary-button" disabled="@busy" @onclick="() => Confirm(pending)">@L["TelegramConfirmLink"]</button>
        }
        else if (link is not null)
        {
            <a class="primary-button telegram-open-bot" href="@link.BotUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-telegram"></i> @L["TelegramOpenBot"] <i class="bi bi-box-arrow-up-right"></i></a>
            <p class="telegram-link-waiting" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @L["TelegramWaitingForBot"]</p>
            <small>@L["TelegramLinkHint"]</small>
        }
        else
        {
            <button class="primary-button" disabled="@(busy || status is null)" @onclick="Begin"><i class="bi bi-telegram"></i> @L["TelegramLink"]</button>
        }
        @if (status is null && !busy)
        {
            <button class="secondary-button" @onclick="Load">@L["TelegramRefreshLink"]</button>
        }
    </section>
    <ConfirmDialog IsOpen="@confirmUnlink" Title="@L["TelegramUnlink"]" Message="@L["TelegramUnlinkConfirm"]" OnClose="Unlink" />
}

@code {
    private TelegramLinkDto? status;
    private TelegramLinkStartDto? link;
    private bool eligible,busy,confirmUnlink;
    private string? error;
    private Task? polling;
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        eligible=user.IsInRole("Seller")||user.IsInRole("Moderator");
        if(eligible) await Load();
    }
    private async Task Load()
    {
        busy=true;error=null;
        try { status=await Telegram.Get<TelegramLinkDto>("api/telegram/link", lifetime.Token); }
        catch(HttpRequestException ex){error=ex.Message;}
        catch(OperationCanceledException) when(lifetime.IsCancellationRequested){}
        finally{busy=false;}
    }
    private async Task Begin()
    {
        busy=true;error=null;
        try
        {
            link = await Telegram.Post<TelegramLinkStartDto>("api/telegram/link", new { }, lifetime.Token);
            polling = WaitForTelegram(link.ExpiresAt, lifetime.Token);
        }
        catch(HttpRequestException ex){error=ex.Message;}
        catch(OperationCanceledException) when(lifetime.IsCancellationRequested){}
        finally{busy=false;}
    }
    private async Task WaitForTelegram(DateTimeOffset expiresAt, CancellationToken ct)
    {
        try
        {
            while (DateTimeOffset.UtcNow < expiresAt)
            {
                await Task.Delay(2000, ct);
                try
                {
                    var next = await Telegram.Get<TelegramLinkDto>("api/telegram/link", ct);
                    await InvokeAsync(() =>
                    {
                        status = next; error = null;
                        if (next.Linked || next.PendingId is not null || !next.Configured) link = null;
                        StateHasChanged();
                    });
                    if (next.Linked || next.PendingId is not null || !next.Configured) return;
                }
                catch (HttpRequestException ex)
                {
                    await InvokeAsync(() => { error = ex.Message; StateHasChanged(); });
                }
                catch (OperationCanceledException) when (!ct.IsCancellationRequested)
                {
                    await InvokeAsync(() => { error = L["ApiUnavailable"]; StateHasChanged(); });
                }
            }
            await InvokeAsync(() => { link = null; error = L["TelegramLinkExpired"]; StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    private async Task Confirm(Guid id)
    {
        busy=true;error=null;
        try {status=await Telegram.Post<TelegramLinkDto>("api/telegram/link/confirm",new ConfirmTelegramLinkRequest(id),lifetime.Token);link=null;}
        catch(HttpRequestException ex){error=ex.Message;}
        catch(OperationCanceledException) when(lifetime.IsCancellationRequested){}
        finally{busy=false;}
    }
    private async Task Unlink(bool confirmed)
    { confirmUnlink=false;if(!confirmed)return;busy=true;try{await Telegram.Unlink();await Load();}catch(HttpRequestException ex){error=ex.Message;}finally{busy=false;} }
    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (polling is not null) await polling;
        lifetime.Dispose();
    }
}
