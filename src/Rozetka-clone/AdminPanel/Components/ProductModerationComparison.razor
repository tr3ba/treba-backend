@inject CatalogApiClient Api
@inject UiTime Time
@using Contracts.Catalog
<details class="operations-comparison"><summary>@O["ResubmissionChanges"]</summary>
@if(error is not null){<p class="feedback-error" role="alert">@error <button class="secondary-button" @onclick="Load">@L["TryAgain"]</button></p>}
else if(data is null){<p>@L["Loading"]</p>}
else if(data.CapturedAt is null){<p class="operations-caption">@O["NoBaseline"]</p>}
else{<p class="operations-caption">@O["BaselineAt",Time.Local(data.CapturedAt.Value).ToString("g")]</p>@if(data.Changes.Count==0){<p>@O["NoChanges"]</p>}else{<div class="table-wrap"><table class="custom-table operations-diff"><thead><tr><th>@O["Field"]</th><th>@O["Before"]</th><th>@O["After"]</th></tr></thead><tbody>@foreach(var c in data.Changes){<tr><td>@Label(c.Field)</td><td><del>@c.Before</del></td><td><ins>@c.After</ins></td></tr>}</tbody></table></div>}}
</details>
@code{[Parameter]public Guid ProductId{get;set;}private ModerationComparisonDto? data;private string? error;protected override Task OnParametersSetAsync()=>Load();private async Task Load(){data=null;error=null;try{data=await Api.Comparison(ProductId);}catch(HttpRequestException e){error=e.Message;}}private string Label(string field)=>string.Join(" / ",field.Split(" / ").Select(part=>L[part].Value));}
