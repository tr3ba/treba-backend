@using Contracts.Marketplace
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject UiTime Time

@if (!FullPage) { <button class="workflow-bell" @onclick="Toggle" aria-label="@L["WorkflowNotifications"]" aria-expanded="@_open"><i class="bi bi-bell"></i>@if (_feed.UnreadCount > 0) { <span>@_feed.UnreadCount</span> }</button> }
@if (FullPage || _open)
{
    <section class="@(FullPage ? "card-box workflow-notifications" : "workflow-notification-popover")" aria-label="@L["WorkflowNotifications"]">
        <div class="workflow-application-heading"><h2>@L["WorkflowNotifications"]</h2><button class="secondary-button" @onclick="MarkAll" disabled="@(_busy || _feed.UnreadCount == 0)">@L["WorkflowReadAll"]</button></div>
        <p class="text-muted">@L["WorkflowNotificationHint"]</p>
        @if (_error is not null) { <p role="alert">@_error <button class="secondary-button" @onclick="Load">@L["TryAgain"]</button></p> }
        @if (_feed.Items.Count == 0 && _error is null) { <div class="workspace-empty"><i class="bi bi-bell-slash"></i><p>@L["WorkflowNoNotifications"]</p></div> }
        @foreach (var item in (FullPage ? _feed.Items : _feed.Items.Take(8)))
        {
            <a class="workflow-notification @(item.Read ? "read" : "unread")" href="@Destination(item)" @onclick="() => Open(item)" @onclick:preventDefault="true"><span class="workflow-notification-icon"><i class="bi @Icon(item.Kind)"></i></span><div><strong>@item.Title</strong><p>@item.Text</p><small>@Time.Local(item.CreatedAt).ToString("g")</small></div>@if (!item.Read) { <span class="workflow-unread-dot" aria-label="@L["WorkflowUnread"]"></span> }</a>
        }
        @if (!FullPage) { <a class="workflow-notification-footer" href="/notifications">@L["WorkflowAllNotifications"] <i class="bi bi-arrow-right"></i></a> }
    </section>
}

@code {
    [Parameter] public bool FullPage { get; set; }
    private NotificationFeed _feed = new([], 0); private bool _open, _busy; private string? _error;
    private readonly CancellationTokenSource _cancel = new(); private Task? _poll;
    protected override async Task OnInitializedAsync() { await Load(); _poll = Poll(); }
    private async Task Toggle() { _open = !_open; if (_open) await Load(); }
    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try { while (await timer.WaitForNextTickAsync(_cancel.Token)) await InvokeAsync(async () => { await Load(); StateHasChanged(); }); }
        catch (OperationCanceledException) { }
    }
    private async Task Load()
    {
        try { using var response = await Http.GetAsync("api/v1/account/notifications", _cancel.Token); await CatalogApiClient.RequireSuccess(response); _feed = await response.Content.ReadFromJsonAsync<NotificationFeed>(cancellationToken: _cancel.Token) ?? new([], 0); _error = null; }
        catch (Exception e) when (e is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) { if (!_cancel.IsCancellationRequested) _error = L["WorkflowNotificationError"]; }
    }
    private string Destination(MarketplaceNotification item) => item.Scope == "admin" ? item.Path : (Configuration["WebsiteLogin:StoreOrigin"] ?? "https://treba.duckdns.org").TrimEnd('/') + item.Path;
    private static string Icon(string kind) => kind switch { "order" or "order-status" => "bi-bag-check", "moderation" => "bi-box-seam", "application" => "bi-shop", _ => "bi-chat-dots" };
    private async Task Open(MarketplaceNotification item) { if (await Mark([item.Key])) { _open = false; Navigation.NavigateTo(Destination(item), forceLoad: item.Scope != "admin"); } }
    private Task MarkAll() => Mark(_feed.Items.Where(x => !x.Read).Select(x => x.Key).ToArray());
    private async Task<bool> Mark(string[] keys)
    {
        if (_busy) return false; _busy = true;
        try { using var response = await Http.PostAsJsonAsync("api/v1/account/notifications/read", new ReadNotificationsRequest(keys), _cancel.Token); await CatalogApiClient.RequireSuccess(response); var read = keys.ToHashSet(); var items = _feed.Items.Select(x => read.Contains(x.Key) ? x with { Read = true } : x).ToList(); _feed = new(items, items.Count(x => !x.Read)); _error = null; return true; }
        catch (HttpRequestException) { _error = L["WorkflowNotificationError"]; return false; }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync() { _cancel.Cancel(); if (_poll is not null) await _poll; _cancel.Dispose(); }
}
