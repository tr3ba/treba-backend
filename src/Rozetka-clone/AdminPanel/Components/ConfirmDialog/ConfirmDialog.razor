@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(string.IsNullOrEmpty(Title) ? L["Confirmation"] : Title)</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <p>@(string.IsNullOrEmpty(Message) ? L["AreYouSure"] : Message)</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">@L["Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="Confirm">@L["Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private Task Cancel() => OnClose.InvokeAsync(false);
    private Task Confirm() => OnClose.InvokeAsync(true);
}
