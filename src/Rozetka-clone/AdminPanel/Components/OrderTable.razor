@inject UiTime Time
<div class="table-wrap"><table class="custom-table"><thead><tr><th>@O["OrderNumber"]</th><th>@O["Customer"]</th><th>@L["Status"]</th><th>@O["Items"]</th><th>@O["Amount"]</th><th>@O["Created"]</th></tr></thead><tbody>
@foreach (var row in Rows)
{
    <tr><td><a href="@($"/orders/{row.Id}")">@row.OrderNumber</a></td><td>@row.CustomerName</td><td><span class="status-badge">@O["Order_" + row.Status]</span></td><td>@row.ItemCount</td><td>@row.TotalAmount.ToString("N2") @row.Currency</td><td>@Time.Local(row.CreatedAt).ToString("g")</td></tr>
}
</tbody></table></div>
@if (Rows.Count == 0) { <p class="empty-state">@O["NoResults"]</p> }
@code { [Parameter, EditorRequired] public IReadOnlyList<OrderRow> Rows { get; set; } = []; }
