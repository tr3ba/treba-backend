@using Contracts.Telegram
@inject TelegramApiClient Telegram
@inject CatalogApiClient Catalog
@inject AuthenticationStateProvider Authentication

@if(eligible)
{
    <section class="card-box dossier-section">
        <div class="card-box-header"><h2 class="card-box-title">@L["SellerAllowedCategories"]</h2></div>
        <p>@L["SellerAllowedCategoriesHint"]</p>
        @if(error is not null){<p class="feedback-error" role="alert">@error</p>}
        @if(saved){<p class="feedback-success" role="status">@L["Saved"]</p>}
        @foreach(var grant in grants.ToList())
        {
            <div class="telegram-category-grant">
                <span>@(categories.FirstOrDefault(c=>c.Id==grant.CategoryId)?.Name??grant.CategoryId.ToString())</span>
                <label><input type="checkbox" checked="@grant.IncludeDescendants" @onchange="e=>Toggle(grant,(bool)e.Value!)" /> @L["IncludeSubcategories"]</label>
                <button type="button" class="secondary-button" @onclick="()=>grants.Remove(grant)">@L["Remove"]</button>
            </div>
        }
        <label class="field-group"><span>@L["Category"]</span><select class="form-control" @bind="selected"><option value="@Guid.Empty">@L["SelectCategory"]</option>
            @foreach(var category in categories.Where(c=>!grants.Any(g=>g.CategoryId==c.Id))){<option value="@category.Id">@category.Name</option>}
        </select></label>
        <div class="telegram-actions">
            <button type="button" class="secondary-button" disabled="@(selected==Guid.Empty||busy||!loaded)" @onclick="Add">@L["Add"]</button>
            <button type="button" class="primary-button" disabled="@(busy||!loaded)" @onclick="Save">@L["SaveChanges"]</button>
        </div>
    </section>
}

@code {
    [Parameter]public Guid SellerId{get;set;}
    private List<SellerCategoryGrantInput> grants=[];
    private IReadOnlyList<Contracts.Catalog.CatalogLookupDto> categories=[];
    private Guid selected;
    private bool eligible,busy,saved,loaded;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        eligible=(await Authentication.GetAuthenticationStateAsync()).User.IsInRole("Administrator");if(!eligible)return;
        busy=true;error=null;saved=false;loaded=false;
        try{categories=(await Catalog.FilterOptions()).Categories;var current=await Telegram.Get<List<SellerCategoryGrantDto>>($"api/v1/admin/telegram/sellers/{SellerId}/categories");grants=current.Select(g=>new SellerCategoryGrantInput(g.CategoryId,g.IncludeDescendants)).ToList();loaded=true;}
        catch(HttpRequestException ex){error=ex.Message;}
        finally{busy=false;}
    }
    private void Add(){if(selected!=Guid.Empty&&!grants.Any(g=>g.CategoryId==selected))grants.Add(new(selected));selected=Guid.Empty;saved=false;}
    private void Toggle(SellerCategoryGrantInput grant,bool value){var index=grants.IndexOf(grant);grants[index]=grant with{IncludeDescendants=value};saved=false;}
    private async Task Save(){busy=true;error=null;saved=false;try{await Telegram.Put($"api/v1/admin/telegram/sellers/{SellerId}/categories",new UpdateSellerCategoriesRequest(grants));saved=true;}catch(HttpRequestException ex){error=ex.Message;}finally{busy=false;}}
}
