@using Contracts.Catalog
@inject CatalogApiClient Api
@if(ProductIds.Count>0)
{
    <section class="workspace-bulk" aria-label="@L["WorkspaceBulkTitle"]">
        <h2>@L["WorkspaceBulkTitle"] (@ProductIds.Count)</h2>
        @if(error is not null){<p class="feedback-error" role="alert">@error</p>}
        @if(preview is null)
        {
            <div class="profile-form-grid">
                <label class="field-group"><span>@L["Price"]</span><select class="form-control" @bind="priceMode"><option value="">@L["WorkspaceKeepValue"]</option><option value="percent">@L["WorkspacePricePercent"]</option><option value="fixed">@L["WorkspacePriceFixed"]</option></select></label>
                @if(priceMode.Length>0){<label class="field-group"><span>@L["WorkspaceNewValue"]</span><input class="form-control" type="number" step="0.01" @bind="priceValue"/></label>}
                <label class="field-group"><span>@L["Stock"] (@L["WorkspaceBlankKeepsValue"])</span><input class="form-control" type="number" min="0" max="1000000" @bind="stock"/></label>
                <label class="field-group"><span>@L["WorkspaceVariantAvailability"]</span><select class="form-control" @bind="availability"><option value="">@L["WorkspaceKeepValue"]</option><option value="true">@L["WorkspaceAvailable"]</option><option value="false">@L["WorkspaceUnavailable"]</option></select></label>
            </div>
            <button type="button" class="primary-button" disabled="@busy" @onclick="Preview">@L["WorkspacePreviewChanges"]</button>
        }
        else
        {
            <p>@L["WorkspaceBulkConfirmHint"]</p>
            <div class="table-wrap"><table class="custom-table"><thead><tr><th>@L["Product"]</th><th>SKU</th><th>@L["Price"]</th><th>@L["Stock"]</th><th>@L["WorkspaceVariantAvailability"]</th></tr></thead><tbody>
                @foreach(var row in preview.Rows){<tr><td>@row.Name</td><td>@row.Sku</td><td>@row.BeforePrice → <strong>@row.AfterPrice</strong>@if(row.BeforeOldPrice.HasValue&&!row.AfterOldPrice.HasValue){<small class="workspace-old-price">@L["WorkspaceOldPriceRemoved"] (@row.BeforeOldPrice)</small>}</td><td>@row.BeforeStock → <strong>@row.AfterStock</strong></td><td>@L[row.BeforeActive?"WorkspaceAvailable":"WorkspaceUnavailable"] → @L[row.AfterActive?"WorkspaceAvailable":"WorkspaceUnavailable"]</td></tr>}
            </tbody></table></div>
            <div class="telegram-actions"><button type="button" class="primary-button" disabled="@busy" @onclick="Apply">@L["WorkspaceApplyChanges"]</button><button type="button" class="secondary-button" disabled="@busy" @onclick="()=>preview=null">@L["Cancel"]</button></div>
        }
    </section>
}
@code {
    [Parameter]public IReadOnlyList<Guid> ProductIds{get;set;}=[];
    [Parameter]public EventCallback OnApplied{get;set;}
    private BulkCatalogPreviewDto? preview;private string priceMode="",availability="";private decimal? priceValue;private int? stock;private string? error;private bool busy;private string selection="";
    protected override void OnParametersSet(){var next=string.Join(',',ProductIds.Order());if(next!=selection){preview=null;selection=next;}}
    private async Task Preview(){busy=true;error=null;try{preview=await Api.PreviewBulk(new(){ProductIds=ProductIds.ToList(),Price=priceMode=="fixed"?priceValue:null,PricePercent=priceMode=="percent"?priceValue:null,StockQuantity=stock,IsActive=availability.Length==0?null:bool.Parse(availability)});}catch(HttpRequestException ex){error=ex.Message;}finally{busy=false;}}
    private async Task Apply(){if(preview is null)return;busy=true;error=null;try{await Api.ApplyBulk(preview.Token);preview=null;await OnApplied.InvokeAsync();}catch(HttpRequestException ex){error=ex.Message;preview=null;}finally{busy=false;}}
}
