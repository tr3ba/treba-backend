<nav class="workspace-pagination" aria-label="@L["Page"]">
    <button type="button" class="secondary-button" disabled="@(CurrentPage <= 1)" @onclick="PreviousPage"><i class="bi bi-chevron-left" aria-hidden="true"></i>@L["Previous"]</button>
    <span>@L["Page"] <strong>@CurrentPage</strong> @L["Of"] <strong>@Math.Max(1, TotalPages)</strong></span>
    <button type="button" class="secondary-button" disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage">@L["Next"]<i class="bi bi-chevron-right" aria-hidden="true"></i></button>
</nav>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            await OnPageChanged.InvokeAsync(CurrentPage - 1);
        }
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            await OnPageChanged.InvokeAsync(CurrentPage + 1);
        }
    }
}
