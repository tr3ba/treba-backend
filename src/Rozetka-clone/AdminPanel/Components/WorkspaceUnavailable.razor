<section class="card-box workspace-empty" role="status">
    <span class="workspace-empty-icon"><i class="bi @Icon" aria-hidden="true"></i></span>
    <h2>@L["SectionUnavailable"]</h2>
    <p>@Message</p>
</section>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "bi-inbox";
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
}
