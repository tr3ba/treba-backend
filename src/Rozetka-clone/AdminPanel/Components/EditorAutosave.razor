@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject ILogger<EditorAutosave> Logger
<section class="workspace-autosave" role="status">
    @if(recoverable)
    {
        <p>@L["WorkspaceRecoveryFound"]</p>
        @if(failed){<p role="alert">@L["WorkspaceAutosaveFailed"]</p>}
        <div class="telegram-actions"><button type="button" class="primary-button" disabled="@busy" @onclick="Restore">@L["WorkspaceRestore"]</button><button type="button" class="secondary-button" disabled="@busy" @onclick="Discard">@L["WorkspaceDiscardBackup"]</button></div>
    }
    else { <span>@L[failed?"WorkspaceAutosaveFailed":saved?"WorkspaceAutosaved":"WorkspaceAutosaveHint"]</span> }
</section>
@code {
    [Parameter,EditorRequired]public string UserScope{get;set;}="";
    [Parameter,EditorRequired]public string DraftKey{get;set;}="";
    [Parameter,EditorRequired]public Func<string> Snapshot{get;set;}=null!;
    [Parameter,EditorRequired]public Func<IReadOnlyList<EditorBackupPhoto>> Photos{get;set;}=null!;
    [Parameter]public bool HasChanges{get;set;}
    [Parameter]public bool Enabled{get;set;}=true;
    [Parameter]public EventCallback<EditorRecovery> OnRestore{get;set;}
    private IJSObjectReference? module;private CancellationTokenSource stopping=new();private Task? loop;
    private bool recoverable,busy,saved,failed;private string lastModel="",lastPhotos="";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender||string.IsNullOrWhiteSpace(UserScope))return;
        try
        {
            module=await Js.InvokeAsync<IJSObjectReference>("import","./"+Assets["js/editor-drafts.js"]);
            recoverable=await module.InvokeAsync<JsonElement?>("meta",UserScope,DraftKey) is not null;
            loop=Loop();StateHasChanged();
        }
        catch(JSException){failed=true;StateHasChanged();}
    }
    private async Task Loop()
    {
        try
        {
            using var timer=new PeriodicTimer(TimeSpan.FromSeconds(2));
            while(await timer.WaitForNextTickAsync(stopping.Token)) await InvokeAsync(async()=>
            {
                if(!Enabled||!HasChanges||recoverable||busy||module is null)return;
                var model=Snapshot();var photos=Photos();var signature=string.Join(',',photos.Select(p=>p.Id));
                if(model==lastModel&&signature==lastPhotos)return;
                try
                {
                    if(signature!=lastPhotos)await module.InvokeVoidAsync("saveEditor",UserScope,DraftKey,model,photos);
                    else await module.InvokeVoidAsync("saveEditorModel",UserScope,DraftKey,model);
                    lastModel=model;lastPhotos=signature;saved=true;failed=false;
                }
                catch(JSException){failed=true;}
                StateHasChanged();
            });
        }
        catch(OperationCanceledException){}catch(JSDisconnectedException){}
    }
    private async Task Restore()
    {
        if(module is null)return;busy=true;
        try
        {
            await using var reference=await module.InvokeAsync<IJSStreamReference>("editorStream",UserScope,DraftKey);
            await using var stream=await reference.OpenReadStreamAsync(80*1024*1024);
            var recovered=await JsonSerializer.DeserializeAsync<EditorRecovery>(stream,new JsonSerializerOptions{PropertyNameCaseInsensitive=true});
            if(recovered is null||recovered.Photos.Count>8||recovered.Photos.Any(p=>p.Bytes.Length>5*1024*1024))throw new JsonException();
            await OnRestore.InvokeAsync(recovered);recoverable=false;saved=true;
        }
        catch(Exception ex) when(ex is JSException or JsonException or IOException or HttpRequestException){failed=true;Logger.LogWarning("Editor recovery failed ({ErrorType}).",ex.GetType().Name);}
        finally{busy=false;}
    }
    private async Task Discard(){if(module is null)return;try{await module.InvokeVoidAsync("remove",UserScope,DraftKey);recoverable=false;saved=false;failed=false;lastModel="";lastPhotos="";}catch(JSException){failed=true;}}
    public async Task ClearAsync()
    {
        stopping.Cancel();if(loop is not null)await loop;
        if(module is not null)try{await module.InvokeVoidAsync("remove",UserScope,DraftKey);}catch(JSException){failed=true;}
    }
    public async Task CheckpointAsync()
    {
        if(module is null)return;
        try{var model=Snapshot();var photos=Photos();await module.InvokeVoidAsync("saveEditor",UserScope,DraftKey,model,photos);lastModel=model;lastPhotos=string.Join(',',photos.Select(p=>p.Id));saved=true;failed=false;}
        catch(JSException){failed=true;}
    }
    public async ValueTask DisposeAsync()
    {
        stopping.Cancel();if(loop is not null)await loop;stopping.Dispose();
        if(module is not null)try{await module.DisposeAsync();}catch(JSDisconnectedException){}
    }
}
