FROM mcr.microsoft.com/dotnet/sdk:10 AS builder
WORKDIR /src

COPY ["treba-backend.csproj", "."]
RUN dotnet restore "treba-backend.csproj"

COPY . .

RUN dotnet build "treba-backend.csproj" -c Release -o /app/build

FROM mcr.microsoft.com/dotnet/sdk:10 AS publish
WORKDIR /src
COPY --from=builder /app/build .
RUN dotnet publish "treba-backend.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10
WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY --from=publish /app/publish .

EXPOSE 5000

ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

ENTRYPOINT ["dotnet", "treba-backend.dll"]