# PostgreSQL — local Docker environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=treba_local_dev
POSTGRES_DB=treba_dev

# Backend JWT — local development only
JWT_SECRET=replace-with-development-secret
JWT_ISSUER=treba-dev
JWT_AUDIENCE=treba-client
JWT_EXPIRATION_MINUTES=60

# Backend security — local development only
SECURITY_ENCRYPTION_KEY=replace-with-development-encryption-key
SECURITY_OTP_HASH_KEY=replace-with-development-otp-hash-key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WayForPay
WAYFORPAY_MERCHANT_ID=
WAYFORPAY_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Treba Marketplace

# Nova Poshta directory and delivery calculation
# Also accepts the AWS/container variable NovaPoshta__ApiKey directly.
NOVA_POSHTA_ENABLED=true
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_CITY_REF=00000000-0000-0000-0000-000000000000
# Empty/default sender city resolves Kyiv through the carrier directory.
NOVA_POSHTA_DEFAULT_WEIGHT_KG=1

# Optional transactional customer notifications
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_STORE_ORIGIN=https://treba.duckdns.org
SMTP_ENABLED=false
SMTP_FROM_ADDRESS=
