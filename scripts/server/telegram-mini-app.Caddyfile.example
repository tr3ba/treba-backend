# Reference for the inspected /opt/treba-caddy/Caddyfile.
# Merge into the existing site; preserve its TLS and other site settings.
treba.duckdns.org {
    @backend path /telegram /telegram/* /js/editor-drafts.js /api/* /uploads/* /ping /health
    handle @backend {
        reverse_proxy host.docker.internal:5000
    }
    handle {
        reverse_proxy host.docker.internal:80
    }
}
